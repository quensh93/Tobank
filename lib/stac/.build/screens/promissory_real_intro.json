{
  "appBar": {
    "leading": {
      "onPressed": {
        "navigationStyle": "pop",
        "actionType": "navigate"
      },
      "icon": {
        "src": "assets/icons/ic_right_arrow.svg",
        "imageType": "asset",
        "color": "{{appColors.current.text.title}}",
        "width": 24.0,
        "height": 24.0,
        "type": "image"
      },
      "type": "iconButton"
    },
    "title": {
      "data": "{{appStrings.promissory.introTitle}}",
      "style": {
        "type": "custom",
        "color": "{{appColors.current.text.title}}",
        "fontSize": 18.0,
        "fontWeight": "w600"
      },
      "type": "text"
    },
    "backgroundColor": "{{appColors.current.background.surface}}",
    "centerTitle": true,
    "type": "appBar"
  },
  "body": {
    "child": {
      "mainAxisAlignment": "center",
      "children": [
        {
          "data": "{{appStrings.promissory.connectingServer}}",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.subtitle}}",
            "fontSize": 16.0
          },
          "type": "text"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "data": "{{appStrings.promissory.loadFromApiDesc}}",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.hint}}",
            "fontSize": 14.0
          },
          "textAlign": "center",
          "type": "text"
        },
        {
          "height": 24.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "actionType": "navigate",
            "assetPath": "lib/stac/tobank/flows/promissory_real/json/promissory_intro.json",
            "navigationStyle": "push"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "left": 32.0,
              "top": 16.0,
              "right": 32.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "Load from local json",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "actionType": "navigate",
            "widgetType": "promissory_real_loader",
            "navigationStyle": "pushReplacement"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "left": 32.0,
              "top": 16.0,
              "right": 32.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "{{appStrings.promissory.loadFromApi}}",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "actionType": "promissory_real_login"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "left": 32.0,
              "top": 16.0,
              "right": 32.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "Static Login (Nooshin)",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "actionType": "navigate",
            "widgetType": "promissory_real_login_form",
            "navigationStyle": "push"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "left": 32.0,
              "top": 16.0,
              "right": 32.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "Dynamic Login",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        }
      ],
      "type": "column"
    },
    "type": "center"
  },
  "type": "scaffold"
}