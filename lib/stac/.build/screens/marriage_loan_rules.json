                    "child": {
                      "data": "{{appStrings.generated.marriage_loan.marriage_loan_rules.title}}",
                      "style": {
                        "type": "custom",
                        "color": "{{appColors.current.text.title}}",
                        "fontSize": 18.0,
                        "fontWeight": "w700"
                      },
                      "textAlign": "center",
                      "textDirection": "rtl",
                      "type": "text"
                    },
                    "type": "padding"
                  },
                  {
                    "color": "{{appColors.current.input.borderEnabled}}",
                    "height": 1.0,
                    "type": "container"
                  },
                  {
                    "child": {
                      "padding": {
                        "left": 16.0,
                        "top": 14.0,
                        "right": 16.0,
                        "bottom": 14.0
                      },
                      "child": {
                        "data": "{{appStrings.generated.marriage_loan.marriage_loan_rules.fullContent}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 14.0,
                          "fontWeight": "w500",
                          "height": 1.9
                        },
                        "textAlign": "right",
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      "type": "singleChildScrollView"
                    },
                    "type": "expanded"
                  }
                ],
                "type": "column"
              },
              "type": "container"
            },
            "type": "padding"
          },
          "type": "expanded"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "padding": {
            "left": 16.0,
            "right": 16.0
          },
