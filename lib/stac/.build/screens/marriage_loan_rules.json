                "color": "{{appColors.current.background.surfaceContainer}}",
                "border": {
                  "color": "{{isMarriageLoanRulesAccepted ? appColors.current.secondary.color : appColors.current.input.borderEnabled}}",
                  "width": 1.0
                },
                "borderRadius": {
                  "topLeft": 8.0,
                  "topRight": 8.0,
                  "bottomLeft": 8.0,
                  "bottomRight": 8.0
                }
              },
              "child": {
                "textDirection": "rtl",
                "children": [
                  {
                    "decoration": {
                      "color": "{{isMarriageLoanRulesAccepted ? appColors.current.secondary.color : \"transparent\"}}",
                      "border": {
                        "color": "{{isMarriageLoanRulesAccepted ? appColors.current.secondary.color : appColors.current.input.borderEnabled}}",
                        "width": 2.0
                      },
                      "borderRadius": {
                        "topLeft": 4.0,
                        "topRight": 4.0,
                        "bottomLeft": 4.0,
                        "bottomRight": 4.0
                      }
                    },
                    "width": 28.0,
                    "height": 28.0,
                    "child": {
                      "child": {
                        "type": "opacity",
                        "opacity": "{{isMarriageLoanRulesAccepted ? 1.0 : 0.0}}",
                        "child": {
                          "src": "assets/icons/ic_check.svg",
                          "color": "{{appColors.current.text.buttonPrimary}}",
                          "width": 20.0,
                          "height": 20.0,
                          "type": "image"
                        }
                      },
                      "type": "center"
                    },
                    "type": "container"
                  },
                  {
                    "width": 12.0,
                    "type": "sizedBox"
                  },
                  {
                    "child": {
                      "data": "{{appStrings.generated.marriage_loan.marriage_loan_rules.acceptTitle}}",
                      "style": {
                        "type": "custom",
                        "color": "{{appColors.current.text.title}}",
                        "fontSize": 15.0,
                        "fontWeight": "w600"
                      },
                      "textDirection": "rtl",
                      "type": "text"
                    },
                    "type": "expanded"
                  }
                ],
                "type": "row"
              },
              "type": "container"
            },
            "onTap": {
              "actionType": "setValue",
              "key": "isMarriageLoanRulesAccepted",
              "value": "{{isMarriageLoanRulesAccepted ? false : true}}"
            },
            "type": "gestureDetector"
          },
          "type": "padding"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "padding": {
            "left": 16.0,
            "right": 16.0
          },
          "child": {
            "type": "reactiveElevatedButton",
            "enabledKey": "isMarriageLoanRulesAccepted",
            "loadingKey": "isMarriageLoanRulesLoading",
            "onPressed": {
              "actionType": "navigate",
              "fileName": "marriage_loan_customer_check",
              "navMode": "localJson",
              "pathOverride": "lib/stac/tobank/flows/marriage_loan/json/marriage_loan_customer_check.json",
              "navigationStyle": "push"
            },
            "style": {
              "foregroundColor": "#FFFFFF",
              "backgroundColor": "{{appColors.current.primary.color}}",
              "disabledForegroundColor": "{{appColors.current.text.subtitle}}",
              "disabledBackgroundColor": "{{appColors.current.input.borderEnabled}}",
              "fixedSize": {
                "width": 999999.0,
                "height": 56.0
              },
              "shape": {
                "type": "roundedRectangleBorder",
                "borderRadius": {
                  "topLeft": 10.0,
                  "topRight": 10.0,
                  "bottomLeft": 10.0,
                  "bottomRight": 10.0
                }
              }
            },
            "child": {
              "data": "{{appStrings.generated.cartable.cartable_intro.next_step}}",
              "style": {
                "type": "custom",
                "color": "#FFFFFF",
                "fontSize": 18.0,
                "fontWeight": "w700"
              },
              "type": "text"
            }
          },
          "type": "padding"
        },
        {
          "height": 18.0,
          "type": "sizedBox"
        }
      ],
      "type": "column"
    },
    "type": "scaffold"
  }
}