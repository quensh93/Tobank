{
  "GET": {
    "statusCode": 200,
    "data": {
      "type": "stateFull",
      "child": {
        "type": "scaffold",
        "backgroundColor": "{{appColors.current.background.surface}}",
        "body": {
          "type": "tobank_onboarding_slider",
          "pages": [
            {
              "title": "{{appStrings.onboarding.page1.title}}",
              "description": "{{appStrings.onboarding.page1.description}}",
              "image": "{{appAssets.icons.onboarding.api.GET_tobank_onboarding.GET.data.child.body.pages.item0.image_onboarding_1_001}}",
              "buttonText": "{{appStrings.onboarding.nextButton}}"
            },
            {
              "title": "{{appStrings.onboarding.page2.title}}",
              "description": "{{appStrings.onboarding.page2.description}}",
              "image": "{{appAssets.icons.onboarding.api.GET_tobank_onboarding.GET.data.child.body.pages.item1.image_onboarding_2_002}}",
              "buttonText": "{{appStrings.onboarding.nextButton}}"
            },
            {
              "title": "{{appStrings.onboarding.page3.title}}",
              "description": "{{appStrings.onboarding.page3.description}}",
              "image": "{{appAssets.icons.onboarding.api.GET_tobank_onboarding.GET.data.child.body.pages.item2.image_onboarding_3_003}}",
              "buttonText": "{{appStrings.onboarding.nextButton}}"
            },
            {
              "title": "{{appStrings.onboarding.page4.title}}",
              "description": "{{appStrings.onboarding.page4.description}}",
              "image": "{{appAssets.icons.onboarding.api.GET_tobank_onboarding.GET.data.child.body.pages.item3.image_onboarding_4_004}}",
              "buttonText": "{{appStrings.onboarding.startButton}}"
            }
          ],
          "onFinish": {
            "actionType": "flowNext",
            "fallback": {
              "actionType": "navigate",
              "navigationStyle": "pop"
            }
          }
        }
      }
    }
  }
}