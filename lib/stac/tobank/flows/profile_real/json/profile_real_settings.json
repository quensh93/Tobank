                    "type": "text"
                  },
                  "type": "expanded"
                },
                {
                  "src": "{{appAssets.icons.arrowLeft}}",
                  "imageType": "asset",
                  "color": "{{appColors.current.text.title}}",
                  "width": 29.0,
                  "height": 29.0,
                  "type": "image"
                }
              ],
              "type": "row"
            },
            "type": "container"
          },
