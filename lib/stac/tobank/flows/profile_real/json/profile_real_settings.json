            "darkLabel": "{{appStrings.profile.real.settings.themeDark}}",
            "systemLabel": "{{appStrings.profile.real.settings.themeSystem}}"
          },
          "type": "gestureDetector"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "child": {
            "padding": {
              "left": 16.0,
