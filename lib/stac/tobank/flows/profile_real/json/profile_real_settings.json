                    "type": "custom",
                    "color": "{{appColors.current.text.title}}",
                    "fontSize": 16.0,
                    "fontWeight": "w600"
                  },
                  "textAlign": "right",
                  "textDirection": "rtl",
                  "type": "text"
                },
                "type": "expanded"
              },
              {
                "width": 22.0,
                "height": 14.0,
                "child": {
                  "type": "reactiveSwitch",
                  "valueKey": "profileRealFaceIdEnabled",
                  "initialValue": false,
                  "activeColor": "{{appColors.current.primary.color}}",
                  "inactiveTrackColor": "#E5E7EB",
                  "inactiveThumbColor": "#FFFFFF",
                  "scale": 0.63
