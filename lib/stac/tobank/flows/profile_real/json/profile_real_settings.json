        },
        {
          "child": {
            "padding": {
              "left": 16.0,
              "top": 16.0,
              "right": 16.0,
              "bottom": 16.0
            },
            "decoration": {
              "color": "{{appColors.current.background.surface}}",
              "border": {
                "color": "{{appColors.current.input.borderEnabled}}",
                "width": 1.0
              },
              "borderRadius": {
                "topLeft": 8.0,
                "topRight": 8.0,
                "bottomLeft": 8.0,
                "bottomRight": 8.0
              }
            },
            "child": {
              "textDirection": "rtl",
              "children": [
                {
                  "src": "{{appAssets.current.icons.logout}}",
                  "imageType": "asset",
                  "width": 24.0,
                  "height": 24.0,
                  "type": "image"
                },
                {
                  "width": 8.0,
                  "type": "sizedBox"
                },
                {
                  "child": {
                    "data": "{{appStrings.profile.real.settings.logout}}",
                    "style": {
                      "type": "custom",
                      "color": "{{appColors.current.text.title}}",
                      "fontSize": 16.0,
                      "fontWeight": "w600"
                    },
                    "textAlign": "right",
