          "decoration": {
            "color": "{{appColors.current.background.surface}}",
            "border": {
              "color": "{{appColors.current.input.borderEnabled}}",
              "width": 1.0
            },
            "borderRadius": {
              "topLeft": 8.0,
              "topRight": 8.0,
              "bottomLeft": 8.0,
              "bottomRight": 8.0
            }
          },
          "child": {
            "textDirection": "rtl",
