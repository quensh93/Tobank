{
  "appBar": {
    "leading": {
      "padding": {
        "left": 12.0
      },
      "child": {
        "child": {
          "src": "{{appAssets.icons.support}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24.0,
          "height": 24.0,
          "type": "image"
        },
        "type": "center"
      },
      "type": "padding"
    },
    "title": {
      "data": "{{appStrings.profile.real.menu.bankInfo}}",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "actions": [
      {
        "padding": {
          "right": 12.0
        },
        "child": {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "icon": {
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31.0,
            "height": 31.0,
            "type": "image"
          },
          "type": "iconButton"
        },
        "type": "padding"
      }
    ],
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "padding": {
      "left": 16.0,
      "top": 16.0,
      "right": 16.0,
      "bottom": 16.0
    },
    "child": {
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "padding": {
            "left": 16.0,
            "top": 16.0,
            "right": 16.0,
            "bottom": 16.0
          },
          "decoration": {
            "color": "{{appColors.current.background.surface}}",
            "border": {
              "color": "{{appColors.current.input.borderEnabled}}",
              "width": 1.0
            },
            "borderRadius": {
              "topLeft": 12.0,
              "topRight": 12.0,
              "bottomLeft": 12.0,
              "bottomRight": 12.0
            }
          },
          "child": {
            "mainAxisAlignment": "spaceBetween",
            "textDirection": "rtl",
            "children": [
              {
                "data": "{{appStrings.profile.real.bankInfo.customerNumberLabel}}",
                "style": {
                  "type": "custom",
                  "color": "{{appColors.current.text.subtitle}}",
                  "fontSize": 16.0,
                  "fontWeight": "w400"
                },
                "textAlign": "right",
                "textDirection": "rtl",
                "type": "text"
              },
              {
                "data": "{{appStrings.profile.real.bankInfo.customerNumberValue}}",
                "style": {
                  "type": "custom",
                  "color": "{{appColors.current.text.title}}",
                  "fontSize": 16.0,
                  "fontWeight": "w600"
                },
                "textAlign": "left",
                "textDirection": "ltr",
                "type": "text"
              }
            ],
            "type": "row"
          },
          "type": "container"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "child": {
            "padding": {
              "left": 16.0,
              "top": 16.0,
              "right": 16.0,
              "bottom": 16.0
            },
            "decoration": {
              "color": "{{appColors.current.background.surface}}",
              "border": {
                "color": "{{appColors.current.input.borderEnabled}}",
                "width": 1.0
              },
              "borderRadius": {
                "topLeft": 12.0,
                "topRight": 12.0,
                "bottomLeft": 12.0,
                "bottomRight": 12.0
              }
            },
            "child": {
              "textDirection": "rtl",
              "children": [
                {
                  "src": "assets/icons/ic_location.svg",
                  "imageType": "asset",
                  "color": "{{appColors.current.text.subtitle}}",
                  "width": 22.0,
                  "height": 22.0,
                  "type": "image"
                },
                {
                  "width": 8.0,
                  "type": "sizedBox"
                },
                {
                  "child": {
                    "data": "{{appStrings.profile.real.bankInfo.registeredAddressTitle}}",
                    "style": {
                      "type": "custom",
                      "color": "{{appColors.current.text.title}}",
                      "fontSize": 16.0,
                      "fontWeight": "w600"
                    },
                    "textAlign": "right",
                    "textDirection": "rtl",
                    "type": "text"
                  },
                  "type": "expanded"
                },
                {
                  "src": "{{appAssets.icons.arrowLeft}}",
                  "imageType": "asset",
                  "color": "{{appColors.current.text.title}}",
                  "width": 35.0,
                  "height": 35.0,
                  "type": "image"
                }
              ],
              "type": "row"
            },
            "type": "container"
          },
          "onTap": {
            "actionType": "showBankAddressBottomSheet",
            "title": "{{appStrings.profile.real.bankInfo.registeredAddressTitle}}",
            "addressLabel": "{{appStrings.profile.real.bankInfo.addressLabel}}",
            "address": "{{appStrings.profile.real.bankInfo.addressValue}}",
            "postalCodeLabel": "{{appStrings.profile.real.bankInfo.postalCodeLabel}}",
            "postalCode": "{{appStrings.profile.real.bankInfo.postalCodeValue}}",
            "editButtonText": "{{appStrings.profile.real.bankInfo.editButtonText}}",
            "editTitle": "{{appStrings.profile.real.bankInfo.editTitle}}",
            "postalCodeHint": "{{appStrings.profile.real.bankInfo.postalCodeHint}}",
            "inquiryButtonText": "{{appStrings.profile.real.bankInfo.inquiryButtonText}}",
            "postalCodeValueKey": "profileRealPostalCode"
          },
          "type": "gestureDetector"
        }
      ],
      "type": "column"
    },
    "type": "singleChildScrollView"
  },
  "type": "scaffold"
}
