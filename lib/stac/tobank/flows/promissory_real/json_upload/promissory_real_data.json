{
  "type": "stateFull",
  "onInit": {
    "actionType": "setValue",
    "values": [
      {
        "key": "isDataFormValid",
        "value": false
      },
      {
        "key": "isIdentityLoading",
        "value": false
      }
    ]
  },
  "child": {
    "appBar": {
      "leading": {
        "onPressed": {
          "navigationStyle": "pop",
          "actionType": "navigate"
        },
        "icon": {
          "src": "assets/icons/ic_right_arrow.svg",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24.0,
          "height": 24.0,
          "type": "image"
        },
        "type": "iconButton"
      },
      "title": {
        "data": "{{appStrings.promissory.dataTitle}}",
        "style": {
          "type": "alias",
          "value": "{{appStyles.appbarStyle}}"
        },
        "textDirection": "rtl",
        "type": "text"
      },
      "centerTitle": true,
      "type": "appBar"
    },
    "body": {
      "autovalidateMode": "onUserInteraction",
      "child": {
        "children": [
          {
            "crossAxisAlignment": "stretch",
            "children": [
              {
                "child": {
                  "padding": {
                    "left": 16.0,
                    "top": 16.0,
                    "right": 16.0,
                    "bottom": 16.0
                  },
                  "child": {
                    "crossAxisAlignment": "stretch",
                    "textDirection": "rtl",
                    "children": [
                      {
                        "padding": {
                          "left": 16.0,
                          "top": 16.0,
                          "right": 16.0,
                          "bottom": 16.0
                        },
                        "decoration": {
                          "color": "{{appColors.current.background.surfaceContainer}}",
                          "border": {
                            "color": "{{appColors.current.input.borderEnabled}}",
                            "width": 1.0
                          },
                          "borderRadius": {
                            "topLeft": 12.0,
                            "topRight": 12.0,
                            "bottomLeft": 12.0,
                            "bottomRight": 12.0
                          }
                        },
                        "child": {
                          "crossAxisAlignment": "stretch",
                          "children": [
                            {
                              "data": "{{appStrings.promissory.receiverDetails}}",
                              "style": {
                                "type": "custom",
                                "color": "{{appColors.current.text.title}}",
                                "fontSize": 16.0,
                                "fontWeight": "w700"
                              },
                              "textDirection": "rtl",
                              "type": "text"
                            },
                            {
                              "height": 12.0,
                              "type": "sizedBox"
                            },
                            {
                              "mainAxisAlignment": "spaceBetween",
                              "textDirection": "rtl",
                              "children": [
                                {
                                  "data": "{{appStrings.promissory.nationalCode}}",
                                  "style": {
                                    "type": "custom",
                                    "color": "{{appColors.current.text.subtitle}}",
                                    "fontSize": 14.0
                                  },
                                  "textDirection": "rtl",
                                  "type": "text"
                                },
                                {
                                  "data": "{{form.receiver_national_code}}",
                                  "style": {
                                    "type": "custom",
                                    "color": "{{appColors.current.text.title}}",
                                    "fontSize": 14.0,
                                    "fontWeight": "w600"
                                  },
                                  "type": "text"
                                }
                              ],
                              "type": "row"
                            },
                            {
                              "height": 8.0,
                              "type": "sizedBox"
                            },
                            {
                              "mainAxisAlignment": "spaceBetween",
                              "textDirection": "rtl",
                              "children": [
                                {
                                  "data": "{{appStrings.promissory.mobileNumber}}",
                                  "style": {
                                    "type": "custom",
                                    "color": "{{appColors.current.text.subtitle}}",
                                    "fontSize": 14.0
                                  },
                                  "textDirection": "rtl",
                                  "type": "text"
                                },
                                {
                                  "data": "{{form.receiver_mobile}}",
                                  "style": {
                                    "type": "custom",
                                    "color": "{{appColors.current.text.title}}",
                                    "fontSize": 14.0,
                                    "fontWeight": "w600"
                                  },
                                  "type": "text"
                                }
                              ],
                              "type": "row"
                            },
                            {
                              "height": 8.0,
                              "type": "sizedBox"
                            },
                            {
                              "mainAxisAlignment": "spaceBetween",
                              "textDirection": "rtl",
                              "children": [
                                {
                                  "data": "{{appStrings.promissory.fullName}}",
                                  "style": {
                                    "type": "custom",
                                    "color": "{{appColors.current.text.subtitle}}",
                                    "fontSize": 14.0
                                  },
                                  "textDirection": "rtl",
                                  "type": "text"
                                },
                                {
                                  "data": "{{receiverIdentity.fullName}}",
                                  "style": {
                                    "type": "custom",
                                    "color": "{{appColors.current.text.title}}",
                                    "fontSize": 14.0,
                                    "fontWeight": "w600"
                                  },
                                  "type": "text"
                                }
                              ],
                              "type": "row"
                            }
                          ],
                          "type": "column"
                        },
                        "type": "container"
                      },
                      {
                        "height": 24.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{appStrings.promissory.amountLabel}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 14.0,
                          "fontWeight": "w600"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 8.0,
                        "type": "sizedBox"
                      },
                      {
                        "type": "textFormField",
                        "id": "promissory_amount",
                        "textDirection": "rtl",
                        "textAlign": "right",
                        "decoration": {
                          "hintText": "{{appStrings.promissory.enterAmount}}",
                          "suffixIcon": {
                            "padding": {
                              "left": 12.0,
                              "top": 12.0,
                              "right": 12.0,
                              "bottom": 12.0
                            },
                            "child": {
                              "data": "{{appStrings.common.rial}}",
                              "style": {
                                "type": "custom",
                                "color": "{{appColors.current.text.subtitle}}",
                                "fontSize": 12.0
                              },
                              "type": "text"
                            },
                            "type": "padding"
                          },
                          "contentPadding": {
                            "left": 16.0,
                            "top": 16.0,
                            "right": 16.0,
                            "bottom": 16.0
                          },
                          "filled": false
                        },
                        "keyboardType": "number",
                        "inputFormatters": [
                          {
                            "type": "allow",
                            "rule": "[0-9]"
                          }
                        ],
                        "validatorRules": [
                          {
                            "rule": "^\\d+$",
                            "message": "{{appStrings.promissory.amountRequired}}"
                          }
                        ],
                        "onChanged": {
                          "actionType": "validateFields",
                          "resultKey": "isDataFormValid",
                          "fields": [
                            {
                              "id": "promissory_amount",
                              "rule": "^\\d+$"
                            },
                            {
                              "id": "promissory_due_date",
                              "rule": "^\\d{4}/\\d{2}/\\d{2}$"
                            }
                          ]
                        }
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{appStrings.promissory.dueDateLabel}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 14.0,
                          "fontWeight": "w600"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 8.0,
                        "type": "sizedBox"
                      },
                      {
                        "child": {
                          "id": "promissory_due_date",
                          "decoration": {
                            "hintText": "{{appStrings.promissory.selectDate}}",
                            "prefixIcon": {
                              "icon": "calendar_today",
                              "iconType": "material",
                              "size": 20.0,
                              "color": "{{appColors.current.text.subtitle}}",
                              "type": "icon"
                            },
                            "contentPadding": {
                              "left": 16.0,
                              "top": 16.0,
                              "right": 16.0,
                              "bottom": 16.0
                            },
                            "filled": false
                          },
                          "textAlign": "right",
                          "textDirection": "rtl",
                          "readOnly": true,
                          "enabled": false,
                          "style": {
                            "type": "custom",
                            "color": "{{appColors.current.text.title}}",
                            "fontSize": 14.0,
                            "fontWeight": "w600"
                          },
                          "validatorRules": [
                            {
                              "rule": "^\\d{4}/\\d{2}/\\d{2}$",
                              "message": "{{appStrings.promissory.dueDateRequired}}"
                            }
                          ],
                          "type": "textFormField"
                        },
                        "onTap": {
                          "actionType": "persianDatePicker",
                          "formFieldId": "promissory_due_date",
                          "firstDate": "1403/01/01",
                          "lastDate": "1450/12/29",
                          "onDateSelected": {
                            "actionType": "validateFields",
                            "resultKey": "isDataFormValid",
                            "fields": [
                              {
                                "id": "promissory_amount",
                                "rule": "^\\d+$"
                              },
                              {
                                "id": "promissory_due_date",
                                "rule": "^\\d{4}/\\d{2}/\\d{2}$"
                              }
                            ]
                          }
                        },
                        "type": "gestureDetector"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{appStrings.promissory.amountOptionalSuffix}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 14.0,
                          "fontWeight": "w600"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 8.0,
                        "type": "sizedBox"
                      },
                      {
                        "id": "description",
                        "decoration": {
                          "hintText": "{{appStrings.promissory.descriptionHint}}",
                          "contentPadding": {
                            "left": 16.0,
                            "top": 16.0,
                            "right": 16.0,
                            "bottom": 16.0
                          },
                          "filled": false
                        },
                        "textAlign": "right",
                        "textDirection": "rtl",
                        "type": "textFormField"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{appStrings.promissory.paymentPlaceOptional}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 14.0,
                          "fontWeight": "w600"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 8.0,
                        "type": "sizedBox"
                      },
                      {
                        "id": "promissory_payment_place",
                        "decoration": {
                          "hintText": "{{appStrings.promissory.paymentPlaceHint}}",
                          "contentPadding": {
                            "left": 16.0,
                            "top": 16.0,
                            "right": 16.0,
                            "bottom": 16.0
                          },
                          "filled": false
                        },
                        "textAlign": "right",
                        "textDirection": "rtl",
                        "type": "textFormField"
                      }
                    ],
                    "type": "column"
                  },
                  "type": "singleChildScrollView"
                },
                "type": "expanded"
              },
              {
                "padding": {
                  "left": 16.0,
                  "top": 16.0,
                  "right": 16.0,
                  "bottom": 16.0
                },
                "child": {
                  "type": "reactiveElevatedButton",
                  "enabledKey": "isDataFormValid",
                  "onPressed": {
                    "actionType": "sequence",
                    "actions": [
                      {
                        "actionType": "setValue",
                        "key": "form.promissory_amount",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "promissory_amount"
                        }
                      },
                      {
                        "actionType": "setValue",
                        "key": "form.promissory_due_date",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "promissory_due_date"
                        }
                      },
                      {
                        "actionType": "setValue",
                        "key": "form.description",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "description"
                        }
                      },
                      {
                        "actionType": "setValue",
                        "key": "form.promissory_payment_place",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "promissory_payment_place"
                        }
                      },
                      {
                        "actionType": "setValue",
                        "key": "receiver.birthDateCompact",
                        "value": "{{replace(receiver.birthDate,'/','')}}}"
                      },
                      {
                        "actionType": "navigate",
                        "navigationStyle": "push",
                        "request": {
                          "url": "http://192.168.179.21:8101/api/configurations/v1.0/configs/resolve/ipaam.builder.form.form.promissory_real_confirm/1",
                          "method": "post",
                          "headers": {
                            "Content-Type": "application/json",
                            "Accept": "*/*"
                          },
                          "body": {
                            "operator": "is",
                            "dimension": {
                              "app": "mobile"
                            }
                          }
                        }
                      }
                    ]
                  },
                  "style": {
                    "backgroundColor": "{{appColors.current.primary.color}}",
                    "elevation": 0.0,
                    "fixedSize": {
                      "width": 999999.0,
                      "height": 56.0
                    },
                    "shape": {
                      "type": "roundedRectangleBorder",
                      "borderRadius": {
                        "topLeft": 12.0,
                        "topRight": 12.0,
                        "bottomLeft": 12.0,
                        "bottomRight": 12.0
                      }
                    }
                  },
                  "child": {
                    "data": "{{isIdentityLoading ? appStrings.promissory.loadingText : appStrings.common.continue}}",
                    "style": {
                      "type": "custom",
                      "color": "{{appColors.current.primary.onPrimary}}",
                      "fontSize": 18.0,
                      "fontWeight": "bold"
                    },
                    "textDirection": "rtl",
                    "type": "text"
                  }
                },
                "type": "padding"
              }
            ],
            "type": "column"
          }
        ],
        "type": "stack"
      },
      "type": "form"
    },
    "type": "scaffold"
  }
}