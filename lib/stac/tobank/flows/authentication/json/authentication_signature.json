          {
            "key": "authenticationSignatureImage",
            "value": ""
          },
          {
            "key": "authenticationHasSignature",
            "value": false
          },
          {
            "key": "authenticationSignatureClearVersion",
            "value": 0
          }
        ]
      }
    ]
