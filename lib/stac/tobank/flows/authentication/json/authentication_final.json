{
  "appBar": {
    "leading": {
      "padding": {
        "left": 12.0
      },
      "child": {
        "child": {
          "src": "{{appAssets.icons.support}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24.0,
          "height": 24.0,
          "type": "image"
        },
        "type": "center"
      },
      "type": "padding"
    },
    "automaticallyImplyLeading": true,
    "title": {
      "data": "{{appStrings.menu.items.authentication}}",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "actions": [
      {
        "padding": {
          "right": 12.0
        },
        "child": {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "icon": {
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31.0,
            "height": 31.0,
            "type": "image"
          },
          "type": "iconButton"
        },
        "type": "padding"
      }
    ],
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "top": false,
    "bottom": true,
    "child": {
      "padding": {
        "left": 16.0,
        "top": 16.0,
        "right": 16.0,
        "bottom": 16.0
      },
      "child": {
        "crossAxisAlignment": "stretch",
        "children": [
          {
            "child": {
              "child": {
                "mainAxisSize": "min",
                "children": [
                  {
                    "src": "{{appAssets.images.authenticationSuccess}}",
                    "imageType": "asset",
                    "height": 210.0,
                    "fit": "contain",
                    "type": "image"
                  },
                  {
                    "height": 28.0,
                    "type": "sizedBox"
                  },
                  {
                    "data": "احراز هویت شما با موفقیت انجام شد!",
                    "style": {
                      "type": "custom",
                      "color": "{{appColors.current.text.title}}",
                      "fontSize": 18.0,
                      "fontWeight": "w600",
                      "height": 1.8
                    },
                    "textAlign": "center",
                    "textDirection": "rtl",
                    "type": "text"
                  }
                ],
                "type": "column"
              },
              "type": "center"
            },
            "type": "expanded"
          },
          {
            "onPressed": {
              "actionType": "sequence",
              "actions": [
                {
                  "actionType": "kyc_persist",
                  "completed": true
                },
                {
                  "actionType": "navigate",
                  "fileName": "dashboard_shell",
                  "navMode": "localJson",
                  "navigationStyle": "pushReplacement"
                }
              ]
            },
            "style": {
              "foregroundColor": "{{appColors.current.primary.onPrimary}}",
              "backgroundColor": "{{appColors.current.primary.color}}",
              "elevation": 0.0,
              "fixedSize": {
                "width": 999999.0,
                "height": 56.0
              },
              "shape": {
                "type": "roundedRectangleBorder",
                "borderRadius": {
                  "topLeft": 12.0,
                  "topRight": 12.0,
                  "bottomLeft": 12.0,
                  "bottomRight": 12.0
                }
              }
            },
            "child": {
              "data": "{{appStrings.common.continue}}",
              "style": {
                "type": "custom",
                "color": "{{appColors.current.primary.onPrimary}}",
                "fontSize": 18.0,
                "fontWeight": "w700"
              },
              "textDirection": "rtl",
              "type": "text"
            },
            "type": "filledButton"
          }
        ],
        "type": "column"
      },
      "type": "padding"
    },
    "type": "safeArea"
  },
  "type": "scaffold"
}
