{
  "appBar": {
    "automaticallyImplyLeading": false,
    "title": {
      "data": "نتیجه عملیات",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "padding": {
      "left": 16.0,
      "top": 24.0,
      "right": 16.0,
      "bottom": 24.0
    },
    "child": {
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "child": {
            "decoration": {
              "color": "#E8F5E9",
              "borderRadius": {
                "topLeft": 36.0,
                "topRight": 36.0,
                "bottomLeft": 36.0,
                "bottomRight": 36.0
              }
            },
            "width": 72.0,
            "height": 72.0,
            "child": {
              "child": {
                "src": "{{appAssets.current.icons.successCheck}}",
                "imageType": "asset",
                "color": "#43A047",
                "width": 40.0,
                "height": 40.0,
                "type": "image"
              },
              "type": "center"
            },
            "type": "container"
          },
          "type": "center"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "data": "عملیات با موفقیت ثبت شد",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.title}}",
            "fontSize": 16.0,
            "fontWeight": "w700"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 8.0,
          "type": "sizedBox"
        },
        {
          "data": "درخواست شما با موفقیت ثبت گردید.",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.hint}}",
            "fontSize": 14.0,
            "fontWeight": "w400"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 48.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            },
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 16.0,
                "topRight": 16.0,
                "bottomLeft": 16.0,
                "bottomRight": 16.0
              }
            }
          },
          "child": {
            "data": "بازگشت به کارت‌ها",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "filledButton"
        }
      ],
      "type": "column"
    },
    "type": "singleChildScrollView"
  },
  "type": "scaffold"
}