{
  "appBar": {
    "automaticallyImplyLeading": false,
    "title": {
      "data": "صدور کارت المثنی",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "padding": {
      "left": 16.0,
      "top": 24.0,
      "right": 16.0,
      "bottom": 24.0
    },
    "child": {
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "child": {
            "decoration": {
              "color": "#E8F5E9",
              "borderRadius": {
                "topLeft": 32.0,
                "topRight": 32.0,
                "bottomLeft": 32.0,
                "bottomRight": 32.0
              }
            },
            "width": 64.0,
            "height": 64.0,
            "child": {
              "child": {
                "src": "{{appAssets.current.icons.successCheck}}",
                "imageType": "asset",
                "color": "#43A047",
                "width": 36.0,
                "height": 36.0,
                "type": "image"
              },
              "type": "center"
            },
            "type": "container"
          },
          "type": "center"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "data": "درخواست شما با موفقیت ثبت شد!",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.title}}",
            "fontSize": 16.0,
            "fontWeight": "w700"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "data": "کد رهگیری: ۱۵۰۳۳۱۹۱۵۱۹۸۳۲۸۴۲۲۴",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.title}}",
            "fontSize": 14.0,
            "fontWeight": "w600"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "data": "مراتب از طریق پیامک به شما اطلاع داده خواهد شد.",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.hint}}",
            "fontSize": 13.0,
            "fontWeight": "w400"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "child": {
            "height": 0.0,
            "type": "sizedBox"
          },
          "type": "expanded"
        },
        {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            },
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 16.0,
                "topRight": 16.0,
                "bottomLeft": 16.0,
                "bottomRight": 16.0
              }
            }
          },
          "child": {
            "data": "بازگشت به لیست خدمات کارت",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "filledButton"
        }
      ],
      "type": "column"
    },
    "type": "padding"
  },
  "type": "scaffold"
}
