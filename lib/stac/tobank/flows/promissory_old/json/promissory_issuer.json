{
  "type": "stateFull",
  "onInit": {
    "actionType": "sequence",
    "actions": [
      {
        "actionType": "netRequest",
        "url": "https://api.tobank.com/api/v1.0/dibalite/customer/info",
        "method": "POST",
        "body": {
          "trackingNumber": "{{userData.trackingNumber}}",
          "nationalCode": "{{userData.nationalCode}}",
          "forceCacheUpdate": false,
          "forceInquireAddressInfo": true,
          "getCustomerStartableProcesses": false,
          "getCustomerDeposits": false,
          "getCustomerActiveCertificate": false
        },
        "onSuccess": {
          "actionType": "log",
          "message": "Customer info fetched"
        }
      }
    ]
  },
  "child": {
    "appBar": {
      "leading": {
        "onPressed": {
          "navigationStyle": "pop",
          "actionType": "navigate"
        },
        "icon": {
          "src": "{{appAssets.icons.arrowBack}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 31.0,
          "height": 31.0,
          "type": "image"
        },
        "type": "iconButton"
      },
      "automaticallyImplyLeading": true,
      "title": {
        "data": "{{appStrings.promissory.issuerTitle}}",
        "style": {
          "type": "alias",
          "value": "{{appStyles.appbarStyle}}"
        },
        "textDirection": "rtl",
        "type": "text"
      },
      "centerTitle": true,
      "type": "appBar"
    },
    "body": {
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "child": {
            "padding": {
              "left": 16.0,
              "top": 16.0,
              "right": 16.0,
              "bottom": 16.0
            },
            "child": {
              "crossAxisAlignment": "stretch",
              "children": [
                {
                  "padding": {
                    "left": 16.0,
                    "top": 16.0,
                    "right": 16.0,
                    "bottom": 16.0
                  },
                  "decoration": {
                    "color": "{{appColors.current.background.surfaceContainer}}",
                    "border": {
                      "color": "{{appColors.current.input.borderEnabled}}",
                      "width": 0.5
                    },
                    "borderRadius": {
                      "topLeft": 8.0,
                      "topRight": 8.0,
                      "bottomLeft": 8.0,
                      "bottomRight": 8.0
                    }
                  },
                  "child": {
                    "crossAxisAlignment": "stretch",
                    "children": [
                      {
                        "data": "{{appStrings.promissory.issuerInfoTitle}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 16.0,
                          "fontWeight": "w700"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "mainAxisAlignment": "spaceBetween",
                        "textDirection": "rtl",
                        "children": [
                          {
                            "data": "{{appStrings.promissory.nationalCode}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.subtitle}}",
                              "fontSize": 14.0,
                              "fontWeight": "w500"
                            },
                            "textDirection": "rtl",
                            "type": "text"
                          },
                          {
                            "data": "{{userData.nationalCode}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.title}}",
                              "fontSize": 14.0,
                              "fontWeight": "w600"
                            },
                            "textDirection": "ltr",
                            "type": "text"
                          }
                        ],
                        "type": "row"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "mainAxisAlignment": "spaceBetween",
                        "textDirection": "rtl",
                        "children": [
                          {
                            "data": "{{appStrings.promissory.mobileNumber}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.subtitle}}",
                              "fontSize": 14.0,
                              "fontWeight": "w500"
                            },
                            "textDirection": "rtl",
                            "type": "text"
                          },
                          {
                            "data": "{{userData.mobile}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.title}}",
                              "fontSize": 14.0,
                              "fontWeight": "w600"
                            },
                            "textDirection": "ltr",
                            "type": "text"
                          }
                        ],
                        "type": "row"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "mainAxisAlignment": "spaceBetween",
                        "textDirection": "rtl",
                        "children": [
                          {
                            "data": "{{appStrings.promissory.fullName}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.subtitle}}",
                              "fontSize": 14.0,
                              "fontWeight": "w500"
                            },
                            "textDirection": "rtl",
                            "type": "text"
                          },
                          {
                            "data": "{{userData.fullName}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.title}}",
                              "fontSize": 14.0,
                              "fontWeight": "w600"
                            },
                            "textDirection": "ltr",
                            "type": "text"
                          }
                        ],
                        "type": "row"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "mainAxisAlignment": "spaceBetween",
                        "textDirection": "rtl",
                        "children": [
                          {
                            "data": "{{appStrings.promissory.depositShaba}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.subtitle}}",
                              "fontSize": 14.0,
                              "fontWeight": "w500"
                            },
                            "textDirection": "rtl",
                            "type": "text"
                          },
                          {
                            "data": "{{form.selected_shaba_number}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.title}}",
                              "fontSize": 14.0,
                              "fontWeight": "w600"
                            },
                            "textDirection": "ltr",
                            "type": "text"
                          }
                        ],
                        "type": "row"
                      }
                    ],
                    "type": "column"
                  },
                  "type": "container"
                },
                {
                  "height": 16.0,
                  "type": "sizedBox"
                },
                {
                  "padding": {
                    "left": 16.0,
                    "top": 16.0,
                    "right": 16.0,
                    "bottom": 16.0
                  },
                  "decoration": {
                    "color": "{{appColors.current.background.surfaceContainer}}",
                    "border": {
                      "color": "{{appColors.current.input.borderEnabled}}",
                      "width": 0.5
                    },
                    "borderRadius": {
                      "topLeft": 8.0,
                      "topRight": 8.0,
                      "bottomLeft": 8.0,
                      "bottomRight": 8.0
                    }
                  },
                  "child": {
                    "crossAxisAlignment": "end",
                    "children": [
                      {
                        "data": "{{appStrings.promissory.issuerResidenceTitle}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 16.0,
                          "fontWeight": "w700"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{appStrings.promissory.postalCode}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.subtitle}}",
                          "fontSize": 14.0,
                          "fontWeight": "w500"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 8.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{userData.postalCode}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 16.0,
                          "fontWeight": "w600"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 16.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{appStrings.promissory.residenceAddress}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.subtitle}}",
                          "fontSize": 14.0,
                          "fontWeight": "w500"
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      },
                      {
                        "height": 8.0,
                        "type": "sizedBox"
                      },
                      {
                        "data": "{{userData.address}}",
                        "style": {
                          "type": "custom",
                          "color": "{{appColors.current.text.title}}",
                          "fontSize": 16.0,
                          "fontWeight": "w600",
                          "height": 1.4
                        },
                        "textDirection": "rtl",
                        "type": "text"
                      }
                    ],
                    "type": "column"
                  },
                  "type": "container"
                }
              ],
              "type": "column"
            },
            "type": "singleChildScrollView"
          },
          "type": "expanded"
        },
        {
          "padding": {
            "left": 16.0,
            "top": 16.0,
            "right": 16.0,
            "bottom": 16.0
          },
          "child": {
            "onPressed": {
              "actionType": "sequence",
              "actions": [
                {
                  "actionType": "validateFields",
                  "resultKey": "validationResult",
                  "fields": [
                    {
                      "id": "userData.postalCode",
                      "rule": ".+"
                    },
                    {
                      "id": "userData.address",
                      "rule": ".+"
                    }
                  ]
                },
                {
                  "actionType": "navigate",
                  "widgetType": "promissory_receiver",
                  "navigationStyle": "push"
                }
              ]
            },
            "style": {
              "backgroundColor": "{{appColors.current.primary.color}}",
              "elevation": 0.0,
              "fixedSize": {
                "width": 999999.0,
                "height": 56.0
              },
              "shape": {
                "type": "roundedRectangleBorder",
                "borderRadius": {
                  "topLeft": 12.0,
                  "topRight": 12.0,
                  "bottomLeft": 12.0,
                  "bottomRight": 12.0
                }
              }
            },
            "child": {
              "data": "{{appStrings.common.continue}}",
              "style": {
                "type": "custom",
                "color": "{{appColors.current.primary.onPrimary}}",
                "fontSize": 18.0,
                "fontWeight": "bold"
              },
              "type": "text"
            },
            "type": "filledButton"
          },
          "type": "padding"
        }
      ],
      "type": "column"
    },
    "type": "scaffold"
  }
}