{
  "appBar": {
    "leading": {
      "padding": {
        "left": 12.0
      },
      "child": {
        "child": {
          "src": "{{appAssets.icons.support}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24.0,
          "height": 24.0,
          "type": "image"
        },
        "type": "center"
      },
      "type": "padding"
    },
    "automaticallyImplyLeading": true,
    "title": {
      "data": "تسهیلات فرزندآوری api واقعی",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "actions": [
      {
        "padding": {
          "right": 12.0
        },
        "child": {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "icon": {
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31.0,
            "height": 31.0,
            "type": "image"
          },
          "type": "iconButton"
        },
        "type": "padding"
      }
    ],
    "centerTitle": true,
    "type": "appBar"
  },
  "body": {
    "padding": {
      "left": 16.0,
      "top": 16.0,
      "right": 16.0,
      "bottom": 16.0
    },
    "child": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "onPressed": {
            "routeName": "child_loan_rules",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "بارگذاری از DART",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "assetPath": "lib/stac/tobank/flows/child_loan/json/child_loan_rules.json",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "بارگذاری از JSON",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "request": {
              "url": "http://192.168.179.21:8101/api/configurations/v1.0/configs/resolve/ipaam.builder.form.form.child_loan_rules/1",
              "method": "post",
              "headers": {
                "Content-Type": "application/json",
                "Accept": "*/*"
              },
              "body": {
                "operator": "is",
                "dimension": {
                  "app": "mobile"
                }
              },
              "actionType": "networkRequest"
            },
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "بارگذاری از JSON API",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "outlinedButton"
        }
      ],
      "type": "column"
    },
    "type": "padding"
  },
  "type": "scaffold"
}