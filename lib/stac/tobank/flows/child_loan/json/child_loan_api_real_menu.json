{
  "appBar": {
    "leading": {
      "padding": {
        "left": 12.0
      },
      "child": {
        "child": {
          "src": "{{appAssets.icons.support}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24.0,
          "height": 24.0,
          "type": "image"
        },
        "type": "center"
      },
      "type": "padding"
    },
    "automaticallyImplyLeading": true,
    "title": {
      "data": "{{appStrings.generated.child_loan.child_loan_api_real_menu.loan_child_api_real}}",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "actions": [
      {
        "padding": {
          "right": 12.0
        },
        "child": {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "icon": {
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31.0,
            "height": 31.0,
            "type": "image"
          },
          "type": "iconButton"
        },
        "type": "padding"
      }
    ],
    "centerTitle": true,
    "type": "appBar"
  },
  "body": {
    "padding": {
      "left": 16.0,
      "top": 16.0,
      "right": 16.0,
      "bottom": 16.0
    },
    "child": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "onPressed": {
            "fileName": "child_loan_rules",
            "navMode": "dart",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "{{appStrings.promissory.debug.loadDart}}",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "fileName": "child_loan_rules",
            "navMode": "localJson",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "{{appStrings.generated.child_loan.child_loan_api_real_menu.upload_json}}",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "fileName": "child_loan_rules",
            "navMode": "apiJson",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "{{appStrings.generated.child_loan.child_loan_api_real_menu.upload_json_api}}",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "outlinedButton"
        }
      ],
      "type": "column"
    },
    "type": "padding"
  },
  "type": "scaffold"
}