{
  "GET": {
    "statusCode": 200,
    "data": {
      "type": "scaffold",
      "appBar": {
        "title": {
          "type": "text",
          "data": "پرداخت اقساط api. واقعی",
          "textDirection": "rtl",
          "style": {
            "type": "alias",
            "value": "{{appStyles.appbarStyle}}"
          }
        },
        "centerTitle": true,
        "leading": {
          "type": "iconButton",
          "onPressed": {
            "actionType": "navigate",
            "navigationStyle": "pop"
          },
          "icon": {
            "type": "image",
            "src": "{{appAssets.icons.arrowRight}}",
            "imageType": "asset",
            "width": 24,
            "height": 24,
            "color": "{{appColors.current.text.title}}"
          }
        },
        "type": "appBar"
      },
      "body": {
        "type": "padding",
        "padding": {"left": 16, "top": 16, "right": 16, "bottom": 16},
        "child": {
          "type": "column",
          "mainAxisAlignment": "center",
          "crossAxisAlignment": "stretch",
          "children": [
            {
              "type": "filledButton",
              "onPressed": {
                "actionType": "showBottomSheet",
                "backgroundColor": "#00000000",
                "sheet": {
                  "type": "container",
                  "decoration": {
                    "color": "{{appColors.current.background.surface}}",
                    "borderRadius": {
                      "topLeft": 18,
                      "topRight": 18
                    }
                  },
                  "child": {
                    "type": "padding",
                    "padding": {
                      "left": 16,
                      "top": 10,
                      "right": 16,
                      "bottom": 16
                    },
                    "child": {
                      "type": "column",
                      "mainAxisSize": "min",
                      "crossAxisAlignment": "stretch",
                      "children": [
                        {
                          "type": "center",
                          "child": {
                            "type": "container",
                            "width": 46,
                            "height": 6,
                            "decoration": {
                              "color": "{{appColors.current.input.borderEnabled}}",
                              "borderRadius": {
                                "topLeft": 999,
                                "topRight": 999,
                                "bottomLeft": 999,
                                "bottomRight": 999
                              }
                            }
                          }
                        },
                        {"type": "sizedBox", "height": 24},
                        {
                          "type": "text",
                          "data": "پرداخت اقساط",
                          "textDirection": "rtl",
                          "textAlign": "center",
                          "style": {
                            "type": "custom",
                            "fontSize": 28,
                            "fontWeight": "w700",
                            "color": "{{appColors.current.text.title}}"
                          }
                        },
                        {"type": "sizedBox", "height": 16},
                        {
                          "type": "gestureDetector",
                          "onTap": {
                            "actionType": "sequence",
                            "actions": [
                              {
                                "actionType": "navigate",
                                "navigationStyle": "pop"
                              },
                              {
                                "actionType": "navigate",
                                "routeName": "installment_payment_list_main",
                                "navigationStyle": "push"
                              }
                            ]
                          },
                          "child": {
                            "type": "container",
                            "width": 9999,
                            "padding": {
                              "left": 25,
                              "top": 10,
                              "right": 25,
                              "bottom": 10
                            },
                            "child": {
                              "type": "text",
                              "data": "پرداخت اقساط خود",
                              "textDirection": "rtl",
                              "textAlign": "right",
                              "style": {
                                "type": "custom",
                                "fontSize": 16,
                                "fontWeight": "w500",
                                "color": "{{appColors.current.text.title}}"
                              }
                            }
                          }
                        },
                        {
                          "type": "divider",
                          "color": "{{appColors.current.input.borderEnabled}}",
                          "thickness": 1,
                          "height": 16
                        },
                        {
                          "type": "gestureDetector",
                          "onTap": {
                            "actionType": "navigate",
                            "navigationStyle": "pop"
                          },
                          "child": {
                            "type": "container",
                            "width": 9999,
                            "padding": {
                              "left": 25,
                              "top": 10,
                              "right": 25,
                              "bottom": 10
                            },
                            "child": {
                              "type": "text",
                              "data": "پرداخت اقساط دیگران",
                              "textDirection": "rtl",
                              "textAlign": "right",
                              "style": {
                                "type": "custom",
                                "fontSize": 16,
                                "fontWeight": "w500",
                                "color": "{{appColors.current.text.title}}"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "style": {
                "padding": {"top": 16, "bottom": 16},
                "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
                "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}"
              },
              "child": {
                "type": "text",
                "data": "بارگزاری از دارت",
                "style": {
                  "type": "custom",
                  "fontSize": 16,
                  "fontWeight": "w600"
                }
              }
            }
          ]
        }
      }
    }
  }
}
