{
  "appBar": {
    "leading": {
      "onPressed": {
        "navigationStyle": "pop",
        "actionType": "navigate"
      },
      "icon": {
        "src": "{{appAssets.icons.arrowBack}}",
        "imageType": "asset",
        "color": "{{appColors.current.text.title}}",
        "width": 31.0,
        "height": 31.0,
        "type": "image"
      },
      "type": "iconButton"
    },
    "automaticallyImplyLeading": true,
    "title": {
      "data": "پرداخت اقساط api. واقعی",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "centerTitle": true,
    "type": "appBar"
  },
  "body": {
    "padding": {
      "left": 16.0,
      "top": 16.0,
      "right": 16.0,
      "bottom": 16.0
    },
    "child": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "onPressed": {
            "actionType": "showBottomSheet",
            "sheet": {
              "decoration": {
                "color": "{{appColors.current.background.surface}}",
                "borderRadius": {
                  "topLeft": 18.0,
                  "topRight": 18.0
                }
              },
              "child": {
                "padding": {
                  "left": 16.0,
                  "top": 10.0,
                  "right": 16.0,
                  "bottom": 16.0
                },
                "child": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "stretch",
                  "children": [
                    {
                      "child": {
                        "decoration": {
                          "color": "{{appColors.current.input.borderEnabled}}",
                          "borderRadius": {
                            "topLeft": 999.0,
                            "topRight": 999.0,
                            "bottomLeft": 999.0,
                            "bottomRight": 999.0
                          }
                        },
                        "width": 46.0,
                        "height": 6.0,
                        "type": "container"
                      },
                      "type": "center"
                    },
                    {
                      "height": 24.0,
                      "type": "sizedBox"
                    },
                    {
                      "data": "پرداخت اقساط",
                      "style": {
                        "type": "custom",
                        "color": "{{appColors.current.text.title}}",
                        "fontSize": 20.0,
                        "fontWeight": "w700"
                      },
                      "textAlign": "center",
                      "textDirection": "rtl",
                      "type": "text"
                    },
                    {
                      "height": 16.0,
                      "type": "sizedBox"
                    },
                    {
                      "child": {
                        "padding": {
                          "left": 25.0,
                          "top": 10.0,
                          "right": 25.0,
                          "bottom": 10.0
                        },
                        "width": 999999.0,
                        "child": {
                          "data": "پرداخت اقساط خود",
                          "style": {
                            "type": "custom",
                            "color": "{{appColors.current.text.title}}",
                            "fontSize": 16.0,
                            "fontWeight": "w500"
                          },
                          "textAlign": "right",
                          "textDirection": "rtl",
                          "type": "text"
                        },
                        "type": "container"
                      },
                      "onTap": {
                        "actionType": "sequence",
                        "actions": [
                          {
                            "navigationStyle": "pop",
                            "actionType": "navigate"
                          },
                          {
                            "navigationStyle": "push",
                            "actionType": "navigate",
                            "fileName": "installment_payment_list_main",
                            "navMode": "apiJson"
                          }
                        ]
                      },
                      "type": "gestureDetector"
                    },
                    {
                      "height": 16.0,
                      "thickness": 1.0,
                      "color": "{{appColors.current.input.borderEnabled}}",
                      "type": "divider"
                    },
                    {
                      "child": {
                        "padding": {
                          "left": 25.0,
                          "top": 10.0,
                          "right": 25.0,
                          "bottom": 10.0
                        },
                        "width": 999999.0,
                        "child": {
                          "data": "پرداخت اقساط دیگران",
                          "style": {
                            "type": "custom",
                            "color": "{{appColors.current.text.title}}",
                            "fontSize": 16.0,
                            "fontWeight": "w500"
                          },
                          "textAlign": "right",
                          "textDirection": "rtl",
                          "type": "text"
                        },
                        "type": "container"
                      },
                      "onTap": {
                        "actionType": "sequence",
                        "actions": [
                          {
                            "navigationStyle": "pop",
                            "actionType": "navigate"
                          },
                          {
                            "navigationStyle": "push",
                            "actionType": "navigate",
                            "fileName": "installment_payment_others_main",
                            "navMode": "apiJson"
                          }
                        ]
                      },
                      "type": "gestureDetector"
                    }
                  ],
                  "type": "column"
                },
                "type": "padding"
              },
              "type": "container"
            },
            "backgroundColor": "#00000000"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "بارگزاری از دارت",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "navigationStyle": "push",
            "actionType": "navigate",
            "fileName": "installment_payment_start",
            "navMode": "apiJson"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "بارگزاری از جیسون محلی",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "fileName": "installment_payment_start",
            "navMode": "apiJson",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            }
          },
          "child": {
            "data": "بارگزاری از json api",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "outlinedButton"
        }
      ],
      "type": "column"
    },
    "type": "padding"
  },
  "type": "scaffold"
}
