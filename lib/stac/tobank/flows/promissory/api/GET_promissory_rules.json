{
  "GET": {
    "statusCode": 200,
    "data": {
      "type": "stateFull",
      "onInit": {
        "actionType": "setValue",
        "key": "isRulesAccepted",
        "value": false
      },
      "child": {
        "type": "scaffold",
        "appBar": {
          "type": "appBar",
          "leading": {
            "type": "iconButton",
            "onPressed": {
              "navigationStyle": "pop",
              "actionType": "navigate"
            },
            "icon": {
              "type": "image",
              "src": "assets/icons/ic_right_arrow.svg",
              "imageType": "asset",
              "color": "{{appColors.current.text.title}}",
              "width": 24.0,
              "height": 24.0
            }
          },
          "title": {
            "type": "text",
            "data": "{{appStrings.promissory.rulesTitle}}",
            "style": {
              "type": "alias",
              "value": "{{appStyles.appbarStyle}}"
            },
            "textDirection": "rtl"
          },
          "centerTitle": true
        },
        "body": {
          "type": "column",
          "crossAxisAlignment": "stretch",
          "children": [
            {
              "type": "sizedBox",
              "height": 16.0
            },
            {
              "type": "expanded",
              "child": {
                "type": "padding",
                "padding": {
                  "left": 16.0,
                  "right": 16.0
                },
                "child": {
                  "type": "container",
                  "decoration": {
                    "color": "{{appColors.current.background.surfaceContainer}}",
                    "border": {
                      "color": "{{appColors.current.input.borderEnabled}}",
                      "width": 1.0
                    },
                    "borderRadius": {
                      "topLeft": 12.0,
                      "topRight": 12.0,
                      "bottomLeft": 12.0,
                      "bottomRight": 12.0
                    }
                  },
                  "child": {
                    "type": "column",
                    "crossAxisAlignment": "stretch",
                    "children": [
                      {
                        "type": "padding",
                        "padding": {
                          "left": 16.0,
                          "top": 16.0,
                          "right": 16.0,
                          "bottom": 16.0
                        },
                        "child": {
                          "type": "text",
                          "data": "{{appStrings.promissory.rulesCardTitle}}",
                          "style": {
                            "type": "custom",
                            "color": "{{appColors.current.text.title}}",
                            "fontSize": 16.0,
                            "fontWeight": "w700"
                          },
                          "textDirection": "rtl"
                        }
                      },
                      {
                        "type": "container",
                        "color": "{{appColors.current.input.borderEnabled}}",
                        "height": 1.0
                      },
                      {
                        "type": "expanded",
                        "child": {
                          "type": "singleChildScrollView",
                          "padding": {
                            "left": 16.0,
                            "top": 16.0,
                            "right": 16.0,
                            "bottom": 16.0
                          },
                          "child": {
                            "type": "text",
                            "data": "{{appStrings.promissory.rulesContent}}",
                            "style": {
                              "type": "custom",
                              "color": "{{appColors.current.text.title}}",
                              "fontSize": 14.0,
                              "fontWeight": "w500",
                              "height": 1.8
                            },
                            "textDirection": "rtl"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "sizedBox",
              "height": 24.0
            },
            {
              "type": "padding",
              "padding": {
                "left": 16.0,
                "right": 16.0
              },
              "child": {
                "type": "container",
                "padding": {
                  "top": 8.0,
                  "bottom": 8.0
                },
                "color": "transparent",
                "child": {
                  "type": "row",
                  "crossAxisAlignment": "center",
                  "textDirection": "rtl",
                  "children": [
                    {
                      "type": "gestureDetector",
                      "onTap": {
                        "actionType": "setValue",
                        "key": "isRulesAccepted",
                        "value": "{{isRulesAccepted ? false : true}}"
                      },
                      "child": {
                        "type": "container",
                        "decoration": {
                          "color": "{{isRulesAccepted ? appColors.current.primary.color : \"transparent\"}}",
                          "border": {
                            "color": "{{isRulesAccepted ? appColors.current.primary.color : appColors.current.text.subtitle}}",
                            "width": 2.0
                          },
                          "borderRadius": {
                            "topLeft": 6.0,
                            "topRight": 6.0,
                            "bottomLeft": 6.0,
                            "bottomRight": 6.0
                          }
                        },
                        "width": 24.0,
                        "height": 24.0,
                        "child": {
                          "type": "center",
                          "child": {
                            "type": "opacity",
                            "opacity": "{{isRulesAccepted ? 1.0 : 0.0}}",
                            "child": {
                              "type": "image",
                              "src": "assets/icons/ic_check.svg",
                              "color": "#FFFFFF",
                              "width": 16.0,
                              "height": 16.0
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "sizedBox",
                      "width": 12.0
                    },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "gestureDetector",
                        "onTap": {
                          "actionType": "setValue",
                          "key": "isRulesAccepted",
                          "value": "{{isRulesAccepted ? false : true}}"
                        },
                        "child": {
                          "type": "text",
                          "data": "{{appStrings.promissory.acceptRulesLabel}}",
                          "style": {
                            "type": "custom",
                            "color": "{{appColors.current.text.title}}",
                            "fontSize": 14.0,
                            "fontWeight": "w500",
                            "height": 1.4
                          },
                          "textDirection": "rtl"
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "sizedBox",
              "height": 24.0
            },
            {
              "type": "padding",
              "padding": {
                "left": 16.0,
                "right": 16.0
              },
              "child": {
                "enabledKey": "isRulesAccepted",
                "onPressed": {
                  "actionType": "navigate",
                  "navigationStyle": "push",
                  "widgetType": "promissory_deposits"
                },
                "style": {
                  "backgroundColor": "{{appColors.current.primary.color}}",
                  "elevation": 0.0,
                  "fixedSize": {
                    "width": 999999.0,
                    "height": 56.0
                  },
                  "shape": {
                    "type": "roundedRectangleBorder",
                    "borderRadius": {
                      "topLeft": 12.0,
                      "topRight": 12.0,
                      "bottomLeft": 12.0,
                      "bottomRight": 12.0
                    }
                  }
                },
                "child": {
                  "type": "text",
                  "data": "{{appStrings.common.continue}}",
                  "style": {
                    "type": "custom",
                    "color": "{{appColors.current.primary.onPrimary}}",
                    "fontSize": 18.0,
                    "fontWeight": "bold"
                  },
                  "textDirection": "rtl"
                },
                "type": "reactiveElevatedButton"
              }
            },
            {
              "type": "sizedBox",
              "height": 16.0
            }
          ]
        }
      }
    }
  }
}