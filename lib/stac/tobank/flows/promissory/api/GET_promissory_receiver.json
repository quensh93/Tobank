{
  "GET": {
    "statusCode": 200,
    "data": {
      "data": {
        "type": "stateful",
        "onInit": {
          "actionType": "setValue",
          "values": [
            {
              "key": "isReceiverValid",
              "value": false
            }
          ]
        },
        "child": {
          "type": "scaffold",
          "appBar": {
            "type": "appBar",
            "title": {
              "type": "text",
              "data": "{{appStrings.generated.promissory.promissory_receiver.receiver}}",
              "textDirection": "rtl",
              "style": {
                "type": "custom",
                "fontSize": 18,
                "fontWeight": "bold",
                "color": "{{appColors.current.text.title}}"
              }
            },
            "centerTitle": true
          },
          "body": {
            "type": "form",
            "autovalidateMode": "onUserInteraction",
            "child": {
              "type": "padding",
              "padding": {
                "all": 16
              },
              "child": {
                "type": "column",
                "crossAxisAlignment": "stretch",
                "children": [
                  {
                    "type": "textFormField",
                    "id": "receiverNationalCode",
                    "keyboardType": "number",
                    "style": {
                      "type": "custom",
                      "fontFamily": "IranYekan"
                    },
                    "decoration": {
                      "labelText": "{{appStrings.generated.promissory.promissory_receiver.national_code_receiver}}",
                      "border": {
                        "type": "outlineInputBorder"
                      }
                    },
                    "validatorRules": [
                      {
                        "rule": "^\\d{10}$",
                        "message": "{{appStrings.generated.promissory.promissory_receiver.national_code}}"
                      }
                    ]
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "textFormField",
                    "id": "receiverMobile",
                    "keyboardType": "phone",
                    "style": {
                      "type": "custom",
                      "fontFamily": "IranYekan"
                    },
                    "decoration": {
                      "labelText": "{{appStrings.generated.promissory.promissory_receiver.mobile_number_receiver}}",
                      "hintText": "0912...",
                      "border": {
                        "type": "outlineInputBorder"
                      }
                    },
                    "validatorRules": [
                      {
                        "rule": "^09\\d{9}$",
                        "message": "{{appStrings.generated.promissory.promissory_receiver.mobile_number_valid_not}}"
                      }
                    ]
                  },
                  {
                    "type": "sizedBox",
                    "height": 16
                  },
                  {
                    "type": "textFormField",
                    "id": "receiverBirthDate",
                    "style": {
                      "type": "custom",
                      "fontFamily": "IranYekan"
                    },
                    "decoration": {
                      "labelText": "{{appStrings.generated.promissory.promissory_receiver.receiver_date}}",
                      "hintText": "1370-01-01",
                      "border": {
                        "type": "outlineInputBorder"
                      }
                    }
                  },
                  {
                    "type": "sizedBox",
                    "height": 24
                  },
                  {
                    "type": "outlinedButton",
                    "style": {
                      "minimumSize": {
                        "width": 999999,
                        "height": 48
                      }
                    },
                    "child": {
                      "type": "text",
                      "data": "{{appStrings.generated.promissory.promissory_receiver.receiver_data}}",
                      "style": {
                        "type": "custom",
                        "fontWeight": "bold"
                      }
                    },
                    "onPressed": {
                      "actionType": "networkRequest",
                      "url": "https://api.tobank.com/dest_user_info",
                      "method": "post",
                      "body": {
                        "birth_date": "{{form.receiverBirthDate}}",
                        "national_code": "{{form.receiverNationalCode}}",
                        "mobile": "{{form.receiverMobile}}"
                      },
                      "results": [
                        {
                          "statusCode": 200,
                          "action": {
                            "actionType": "multiAction",
                            "actions": [
                              {
                                "actionType": "setValue",
                                "values": [
                                  {
                                    "key": "isReceiverValid",
                                    "value": true
                                  }
                                ]
                              },
                              {
                                "actionType": "showDialog",
                                "widget": {
                                  "type": "alertDialog",
                                  "title": {
                                    "type": "text",
                                    "data": "{{appStrings.generated.promissory.promissory_receiver.receiver_confirm_name}}",
                                    "textDirection": "rtl"
                                  },
                                  "content": {
                                    "type": "text",
                                    "data": "{{appStrings.generated.promissory.GET_promissory_receiver.name_receive}}",
                                    "textDirection": "rtl"
                                  },
                                  "actions": [
                                    {
                                      "type": "textButton",
                                      "child": {
                                        "type": "text",
                                        "data": "{{appStrings.generated.gift_card.gift_card_message.close_button}}"
                                      },
                                      "onPressed": {
                                        "actionType": "closeDialog"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer"
                  },
                  {
                    "type": "reactiveElevatedButton",
                    "enabledKey": "isReceiverValid",
                    "enabled": false,
                    "style": {
                      "backgroundColor": "{{appColors.current.primary.color}}",
                      "foregroundColor": "{{appColors.current.primary.onPrimary}}",
                      "minimumSize": {
                        "width": 999999,
                        "height": 56
                      },
                      "shape": {
                        "type": "roundedRectangle",
                        "borderRadius": {
                          "all": 12
                        }
                      }
                    },
                    "child": {
                      "type": "text",
                      "data": "{{appStrings.common.continue}}",
                      "style": {
                        "type": "custom",
                        "fontSize": 18,
                        "fontWeight": "bold"
                      }
                    },
                    "onPressed": {
                      "actionType": "navigate",
                      "fileName": "promissory_data",
                      "navMode": "apiJson"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
