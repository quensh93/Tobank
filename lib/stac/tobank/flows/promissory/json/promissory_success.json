            {
              "key": "promissoryId",
              "value": "{{data.data.promissoryId}}"
            },
            {
              "key": "transactionAmount",
              "value": "{{data.data.amount}}"
            },
            {
              "key": "transactionType",
              "value": "{{appStrings.promissory.issuanceTitle}}"
            },
            {
              "key": "transactionTime",
              "value": "{{data.data.transactionTime}}"
            },
            {
              "key": "paymentMethod",
              "value": "{{form.payment_method}}"
