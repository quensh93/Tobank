{
  "type": "stateFull",
  "onInit": {
    "actionType": "setValue",
    "values": [
      {
        "key": "cardsManagement.reissue.selectedTemplate",
        "value": "#ED1B2F"
      },
      {
        "key": "cardsManagement.reissue.templateIsFront",
        "value": true
      }
    ]
  },
  "child": {
    "type": "scaffold",
    "appBar": {
      "type": "appBar",
      "leading": null,
      "automaticallyImplyLeading": false,
      "actions": [
        {
          "type": "iconButton",
          "onPressed": {
            "actionType": "navigate",
            "navigationStyle": "pop"
          },
          "icon": {
            "type": "image",
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31.0,
            "height": 31.0
          }
        }
      ],
      "title": {
        "type": "text",
        "data": "صدور کارت المثنی",
        "style": {
          "type": "alias",
          "value": "{{appStyles.appbarStyle}}"
        },
        "textDirection": "rtl"
      },
      "centerTitle": true
    },
    "backgroundColor": "{{appColors.current.background.surface}}",
    "body": {
      "type": "padding",
      "padding": {
        "left": 16.0,
        "top": 16.0,
        "right": 16.0,
        "bottom": 16.0
      },
      "child": {
        "type": "column",
        "crossAxisAlignment": "stretch",
        "children": [
          {
            "type": "text",
            "data": "رنگ کارت خود را انتخاب کنید",
            "textDirection": "rtl",
            "textAlign": "right",
            "style": {
              "type": "custom",
              "fontSize": 20.0,
              "fontWeight": "w700",
              "color": "{{appColors.current.text.title}}"
            }
          },
          {
            "type": "sizedBox",
            "height": 20.0
          },
          {
            "type": "depositCardTemplatePicker",
            "selectedColorKey": "cardsManagement.reissue.selectedTemplate",
            "selectedFaceKey": "cardsManagement.reissue.templateIsFront"
          },
          {
            "type": "expanded",
            "child": {
              "type": "sizedBox",
              "height": 0.0
            }
          },
          {
            "type": "filledButton",
            "onPressed": {
              "actionType": "showLogoutConfirmDialog",
              "title": "تایید انتخاب",
              "description": "آیا از انتخاب رنگ کارت المثنی اطمینان دارید؟",
              "positiveText": "تایید",
              "negativeText": "انصراف",
              "positiveAction": {
                "actionType": "sequence",
                "actions": [
                  {
                    "actionType": "closeDialog"
                  },
                  {
                    "actionType": "navigate",
                    "fileName": "dashboard_card_reissue_receipt",
                    "navMode": "localJson",
                    "navigationStyle": "push"
                  }
                ]
              },
              "negativeAction": {
                "actionType": "closeDialog"
              }
            },
            "style": {
              "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
              "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
              "elevation": 0.0,
              "fixedSize": {
                "width": 999999.0,
                "height": 56.0
              },
              "shape": {
                "type": "roundedRectangleBorder",
                "borderRadius": {
                  "topLeft": 16.0,
                  "topRight": 16.0,
                  "bottomLeft": 16.0,
                  "bottomRight": 16.0
                }
              }
            },
            "child": {
              "type": "text",
              "data": "تایید و ادامه",
              "textDirection": "rtl",
              "style": {
                "type": "custom",
                "fontSize": 18.0,
                "fontWeight": "w700",
                "color": "{{appColors.current.button.primary.foregroundColor}}"
              }
            }
          },
          {
            "type": "sizedBox",
            "height": 8.0
          }
        ]
      }
    }
  }
}
