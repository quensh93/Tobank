{
  "appBar": {
    "automaticallyImplyLeading": false,
    "title": {
      "data": "{{appStrings.generated.card_management.card_management_reissue_color.card_reissue}}",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "padding": {
      "left": 16.0,
      "top": 24.0,
      "right": 16.0,
      "bottom": 24.0
    },
    "child": {
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "child": {
            "decoration": {
              "color": "#E8F5E9",
              "borderRadius": {
                "topLeft": 32.0,
                "topRight": 32.0,
                "bottomLeft": 32.0,
                "bottomRight": 32.0
              }
            },
            "width": 64.0,
            "height": 64.0,
            "child": {
              "child": {
                "src": "{{appAssets.current.icons.successCheck}}",
                "imageType": "asset",
                "color": "#43A047",
                "width": 36.0,
                "height": 36.0,
                "type": "image"
              },
              "type": "center"
            },
            "type": "container"
          },
          "type": "center"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "data": "{{appStrings.generated.deposit_more_options.deposit_card_issue_result.title}}",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.title}}",
            "fontSize": 16.0,
            "fontWeight": "w700"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "data": "{{appStrings.generated.card_management.card_management_reissue_receipt.tracking_code}}",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.title}}",
            "fontSize": 14.0,
            "fontWeight": "w600"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "data": "{{appStrings.generated.home_page.tobank_special_services_page.sms_notification_message}}",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.hint}}",
            "fontSize": 13.0,
            "fontWeight": "w400"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "child": {
            "height": 0.0,
            "type": "sizedBox"
          },
          "type": "expanded"
        },
        {
          "onPressed": {
            "fileName": "card_management_root",
            "navMode": "localJson",
            "navigationStyle": "pushAndRemoveAll",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 8.0,
              "bottom": 8.0
            },
            "minimumSize": {
              "width": 0.0,
              "height": 56.0
            },
            "elevation": 0.0,
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 8.0,
                "topRight": 8.0,
                "bottomLeft": 8.0,
                "bottomRight": 8.0
              }
            }
          },
          "child": {
            "data": "{{appStrings.generated.card_management.card_management_reissue_receipt.back_list_services_card}}",
            "style": {
              "type": "custom",
              "fontSize": 14.0,
              "fontWeight": "w700"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "filledButton"
        }
      ],
      "type": "column"
    },
    "type": "padding"
  },
  "type": "scaffold"
}
