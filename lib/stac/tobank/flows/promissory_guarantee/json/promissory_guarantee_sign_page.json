{
  "appBar": {
    "leading": {
      "padding": {
        "left": 12.0
      },
      "child": {
        "child": {
          "src": "{{appAssets.icons.support}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24.0,
          "height": 24.0,
          "type": "image"
        },
        "type": "center"
      },
      "type": "padding"
    },
    "automaticallyImplyLeading": true,
    "title": {
      "data": "ضمانت سفته",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "actions": [
      {
        "padding": {
          "right": 12.0
        },
        "child": {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "icon": {
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31.0,
            "height": 31.0,
            "type": "image"
          },
          "type": "iconButton"
        },
        "type": "padding"
      }
    ],
    "centerTitle": true,
    "type": "appBar"
  },
  "body": {
    "crossAxisAlignment": "stretch",
    "textDirection": "rtl",
    "children": [
      {
        "child": {
          "type": "sizedBox"
        },
        "type": "expanded"
      },
      {
        "padding": {
          "left": 16.0,
          "right": 16.0
        },
        "child": {
          "crossAxisAlignment": "stretch",
          "children": [
            {
              "child": {
                "src": "assets/icons/sign-pdf.svg",
                "imageType": "asset",
                "width": 160.0,
                "height": 160.0,
                "type": "image"
              },
              "type": "center"
            },
            {
              "height": 20.0,
              "type": "sizedBox"
            },
            {
              "data": "با انتخاب گزینه امضای سفته، امضاء شما پایین تصویر سفته به صورت الکترونیکی ثبت می‌شود و این عمل به منزله تایید درخواست و ثبت نهایی فرآیند است.",
              "style": {
                "type": "custom",
                "color": "{{appColors.current.text.title}}",
                "fontSize": 14.0,
                "fontWeight": "w600",
                "height": 1.7
              },
              "textAlign": "center",
              "textDirection": "rtl",
              "type": "text"
            }
          ],
          "type": "column"
        },
        "type": "padding"
      },
      {
        "child": {
          "type": "sizedBox"
        },
        "type": "expanded"
      },
      {
        "padding": {
          "left": 16.0,
          "top": 16.0,
          "right": 16.0,
          "bottom": 16.0
        },
        "child": {
          "onPressed": {
            "actionType": "showAppDialog",
            "dialog": {
              "decoration": {
                "color": "{{appColors.current.background.surface}}",
                "borderRadius": {
                  "topLeft": 16.0,
                  "topRight": 16.0,
                  "bottomLeft": 16.0,
                  "bottomRight": 16.0
                }
              },
              "child": {
                "padding": {
                  "left": 16.0,
                  "top": 18.0,
                  "right": 16.0,
                  "bottom": 16.0
                },
                "child": {
                  "mainAxisSize": "min",
                  "crossAxisAlignment": "stretch",
                  "children": [
                    {
                      "child": {
                        "src": "assets/icons/ic_warning_red.svg",
                        "imageType": "asset",
                        "width": 56.0,
                        "height": 56.0,
                        "type": "image"
                      },
                      "type": "center"
                    },
                    {
                      "height": 16.0,
                      "type": "sizedBox"
                    },
                    {
                      "data": "از امضای ضمانت سفته مطمئن هستید؟",
                      "style": {
                        "type": "custom",
                        "color": "{{appColors.current.text.title}}",
                        "fontSize": 17.0,
                        "fontWeight": "w700",
                        "height": 1.6
                      },
                      "textAlign": "center",
                      "textDirection": "rtl",
                      "type": "text"
                    },
                    {
                      "height": 18.0,
                      "type": "sizedBox"
                    },
                    {
                      "textDirection": "ltr",
                      "children": [
                        {
                          "child": {
                            "onPressed": {
                              "actionType": "fingerPrint",
                              "title": "احراز هویت",
                              "description": "لطفا برای ادامه امضای ضمانت سفته از اثر انگشت استفاده کنید",
                              "onSuccess": {
                                "actionType": "sequence",
                                "actions": [
                                  {
                                    "actionType": "closeDialog"
                                  },
                                  {
                                    "actionType": "navigate",
                                    "fileName": "promissory_guarantee_final_page",
                                    "navMode": "localJson",
                                    "navigationStyle": "pushReplacement"
                                  }
                                ]
                              },
                              "onFailure": {
                                "actionType": "showSnackBar",
                                "title": "عدم احراز هویت",
                                "description": "احراز هویت انجام نشد. لطفا دوباره تلاش کنید.",
                                "type": "error"
                              }
                            },
                            "style": {
                              "foregroundColor": "#FFFFFF",
                              "backgroundColor": "#D91F2A",
                              "elevation": 0.0,
                              "fixedSize": {
                                "width": 999999.0,
                                "height": 50.0
                              },
                              "shape": {
                                "type": "roundedRectangleBorder",
                                "borderRadius": {
                                  "topLeft": 12.0,
                                  "topRight": 12.0,
                                  "bottomLeft": 12.0,
                                  "bottomRight": 12.0
                                }
                              }
                            },
                            "child": {
                              "data": "تایید",
                              "style": {
                                "type": "custom",
                                "color": "#FFFFFF",
                                "fontSize": 16.0,
                                "fontWeight": "w700"
                              },
                              "type": "text"
                            },
                            "type": "filledButton"
                          },
                          "type": "expanded"
                        },
                        {
                          "width": 12.0,
                          "type": "sizedBox"
                        },
                        {
                          "child": {
                            "onPressed": {
                              "actionType": "closeDialog"
                            },
                            "style": {
                              "fixedSize": {
                                "width": 999999.0,
                                "height": 50.0
                              },
                              "side": {
                                "color": "{{appColors.current.input.borderEnabled}}",
                                "width": 1.2
                              },
                              "shape": {
                                "type": "roundedRectangleBorder",
                                "borderRadius": {
                                  "topLeft": 12.0,
                                  "topRight": 12.0,
                                  "bottomLeft": 12.0,
                                  "bottomRight": 12.0
                                }
                              }
                            },
                            "child": {
                              "data": "لغو",
                              "style": {
                                "type": "custom",
                                "color": "{{appColors.current.text.title}}",
                                "fontSize": 16.0,
                                "fontWeight": "w700"
                              },
                              "type": "text"
                            },
                            "type": "outlinedButton"
                          },
                          "type": "expanded"
                        }
                      ],
                      "type": "row"
                    }
                  ],
                  "type": "column"
                },
                "type": "padding"
              },
              "type": "container"
            },
            "barrierDismissible": true,
            "barrierColor": "#80000000",
            "backgroundColor": "#00000000"
          },
          "style": {
            "foregroundColor": "#FFFFFF",
            "backgroundColor": "#D91F2A",
            "elevation": 0.0,
            "fixedSize": {
              "width": 999999.0,
              "height": 56.0
            },
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 12.0,
                "topRight": 12.0,
                "bottomLeft": 12.0,
                "bottomRight": 12.0
              }
            }
          },
          "child": {
            "data": "امضای سفته",
            "style": {
              "type": "custom",
              "color": "#FFFFFF",
              "fontSize": 18.0,
              "fontWeight": "w700"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "filledButton"
        },
        "type": "padding"
      }
    ],
    "type": "column"
  },
  "type": "scaffold"
}
