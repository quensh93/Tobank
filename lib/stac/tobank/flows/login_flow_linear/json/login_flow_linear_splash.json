{
  "type": "onMountAction",
  "delay": 2000,
  "action": {
    "actionType": "navigate",
    "navigationStyle": "pushReplacement",
    "request": {
      "url": "http://192.168.179.21:8101/api/configurations/v1.0/configs/resolve/ipaam.builder.form.form.login_flow_linear_onboarding/1",
      "body": {
        "operator": "is",
        "dimension": {
          "app": "mobile"
        }
      },
      "method": "post",
      "headers": {
        "Accept": "*/*",
        "Content-Type": "application/json"
      }
    }
  },
  "child": {
    "backgroundColor": "{{appColors.current.background.surface}}",
    "body": {
      "children": [
        {
          "alignment": "center",
          "child": {
            "mainAxisSize": "min",
            "crossAxisAlignment": "center",
            "children": [
              {
                "src": "{{appAssets.icons.logoRed}}",
                "imageType": "asset",
                "width": 229,
                "height": 36,
                "fit": "contain",
                "type": "image"
              },
              {
                "height": 27,
                "type": "sizedBox"
              },
              {
                "data": "{{appStrings.splash.slogan}}",
                "style": {
                  "type": "custom",
                  "color": "{{appColors.current.text.title}}",
                  "fontSize": 20,
                  "fontWeight": "bold",
                  "fontFamily": "IranYekan"
                },
                "textDirection": "rtl",
                "type": "text"
              }
            ],
            "type": "column"
          },
          "type": "align"
        },
        {
          "alignment": "bottomCenter",
          "child": {
            "padding": {
              "bottom": 49
            },
            "child": {
              "data": "{{appStrings.splash.version}} {{appData.version}}",
              "style": {
                "type": "custom",
                "color": "{{appColors.current.text.subtitle}}",
                "fontSize": 16,
                "fontWeight": "w400",
                "fontFamily": "IranYekan"
              },
              "textDirection": "rtl",
              "type": "text"
            },
            "type": "padding"
          },
          "type": "align"
        }
      ],
      "type": "stack"
    },
    "type": "scaffold"
  }
}
