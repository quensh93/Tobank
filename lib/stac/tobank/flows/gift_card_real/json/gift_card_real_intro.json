{
  "appBar": {
    "leading": {
      "padding": {
        "left": 12
      },
      "child": {
        "child": {
          "src": "{{appAssets.icons.support}}",
          "imageType": "asset",
          "color": "{{appColors.current.text.title}}",
          "width": 24,
          "height": 24,
          "type": "image"
        },
        "type": "center"
      },
      "type": "padding"
    },
    "automaticallyImplyLeading": true,
    "title": {
      "data": "کارت هدیه",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "actions": [
      {
        "padding": {
          "right": 12
        },
        "child": {
          "onPressed": {
            "navigationStyle": "pop",
            "actionType": "navigate"
          },
          "icon": {
            "src": "{{appAssets.icons.arrowBack}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 31,
            "height": 31,
            "type": "image"
          },
          "type": "iconButton"
        },
        "type": "padding"
      }
    ],
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "children": [
      {
        "alignment": "center",
        "child": {
          "padding": {
            "left": 16,
            "right": 16,
            "bottom": 72
          },
          "child": {
            "mainAxisSize": "min",
            "children": [
              {
                "src": "assets/images/empty_list.png",
                "imageType": "asset",
                "width": 220,
                "height": 220,
                "fit": "contain",
                "type": "image"
              },
              {
                "height": 24,
                "type": "sizedBox"
              },
              {
                "data": "شما کارتی خریداری نکرده‌اید",
                "style": {
                  "type": "custom",
                  "color": "{{appColors.current.text.subtitle}}",
                  "fontSize": 16,
                  "fontWeight": "w600"
                },
                "textAlign": "center",
                "textDirection": "rtl",
                "type": "text"
              }
            ],
            "type": "column"
          },
          "type": "padding"
        },
        "type": "align"
      },
      {
        "alignment": "bottomCenter",
        "child": {
          "padding": {
            "left": 16,
            "right": 16,
            "bottom": 54
          },
          "child": {
            "onPressed": {
              "actionType": "showBottomSheet",
              "sheet": {
                "type": "stateFull",
                "onInit": {
                  "actionType": "sequence",
                  "actions": [
                    {
                      "actionType": "showGiftCardPurchaseBottomSheet",
                      "continueAction": {
                        "actionType": "navigate",
                        "navigationStyle": "push",
                        "request": {
                          "url": "http://192.168.179.21:8101/api/configurations/v1.0/configs/resolve/ipaam.builder.form.form.gift_card_real_select_amount/1",
                          "body": {
                            "operator": "is",
                            "dimension": {
                              "app": "mobile"
                            }
                          },
                          "method": "post",
                          "headers": {
                            "Accept": "*/*",
                            "Content-Type": "application/json"
                          }
                        }
                      }
                    },
                    {
                      "navigationStyle": "pop",
                      "actionType": "navigate"
                    }
                  ]
                },
                "child": {
                  "width": 0,
                  "height": 0,
                  "type": "sizedBox"
                }
              },
              "backgroundColor": "#00000000"
            },
            "style": {
              "foregroundColor": "{{appColors.current.primary.onPrimary}}",
              "backgroundColor": "{{appColors.current.primary.color}}",
              "elevation": 0,
              "fixedSize": {
                "width": 190,
                "height": 64
              },
              "shape": {
                "type": "roundedRectangleBorder",
                "borderRadius": {
                  "topLeft": 14,
                  "topRight": 14,
                  "bottomLeft": 14,
                  "bottomRight": 14
                }
              }
            },
            "child": {
              "mainAxisSize": "min",
              "textDirection": "rtl",
              "children": [
                {
                  "icon": "add",
                  "iconType": "material",
                  "size": 22,
                  "color": "{{appColors.current.primary.onPrimary}}",
                  "type": "icon"
                },
                {
                  "width": 8,
                  "type": "sizedBox"
                },
                {
                  "data": "خرید کارت هدیه",
                  "style": {
                    "type": "custom",
                    "color": "{{appColors.current.primary.onPrimary}}",
                    "fontSize": 16,
                    "fontWeight": "w700"
                  },
                  "textDirection": "rtl",
                  "type": "text"
                }
              ],
              "type": "row"
            },
            "type": "filledButton"
          },
          "type": "padding"
        },
        "type": "align"
      }
    ],
    "type": "stack"
  },
  "type": "scaffold"
}
