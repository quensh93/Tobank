{
  "appBar": {
    "leading": {
      "onPressed": {
        "navigationStyle": "pop",
        "actionType": "navigate"
      },
      "icon": {
        "src": "{{appAssets.icons.arrowRight}}",
        "imageType": "asset",
        "color": "{{appColors.current.text.title}}",
        "width": 24.0,
        "height": 24.0,
        "type": "image"
      },
      "type": "iconButton"
    },
    "title": {
      "data": "{{appStrings.menu.items.home}}",
      "style": {
        "type": "alias",
        "value": "{{appStyles.appbarStyle}}"
      },
      "textDirection": "rtl",
      "type": "text"
    },
    "centerTitle": true,
    "type": "appBar"
  },
  "backgroundColor": "{{appColors.current.background.surface}}",
  "body": {
    "padding": {
      "left": 16.0,
      "top": 16.0,
      "right": 16.0,
      "bottom": 16.0
    },
    "child": {
      "mainAxisAlignment": "center",
      "crossAxisAlignment": "stretch",
      "children": [
        {
          "data": "{{appStrings.promissory.debug.flowEntryPoints}}",
          "style": {
            "type": "custom",
            "color": "{{appColors.current.text.title}}",
            "fontSize": 18.0,
            "fontWeight": "bold"
          },
          "textAlign": "center",
          "textDirection": "rtl",
          "type": "text"
        },
        {
          "height": 32.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "routeName": "tobank_home_page_dart",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            },
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 16.0,
                "topRight": 16.0,
                "bottomLeft": 16.0,
                "bottomRight": 16.0
              }
            }
          },
          "child": {
            "data": "{{appStrings.promissory.debug.loadDart}}",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "onPressed": {
            "assetPath": "lib/stac/tobank/flows/home_page/json/tobank_home_page_dart.json",
            "navigationStyle": "push",
            "actionType": "navigate"
          },
          "style": {
            "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
            "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            },
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 16.0,
                "topRight": 16.0,
                "bottomLeft": 16.0,
                "bottomRight": 16.0
              }
            }
          },
          "child": {
            "data": "{{appStrings.promissory.debug.loadLocalJson}}",
            "style": {
              "type": "custom",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "filledButton"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "style": {
            "foregroundColor": "{{appColors.current.text.hint}}",
            "padding": {
              "top": 16.0,
              "bottom": 16.0
            },
            "side": {
              "color": "{{appColors.current.input.borderEnabled}}",
              "width": 1.0
            },
            "shape": {
              "type": "roundedRectangleBorder",
              "borderRadius": {
                "topLeft": 16.0,
                "topRight": 16.0,
                "bottomLeft": 16.0,
                "bottomRight": 16.0
              }
            }
          },
          "child": {
            "data": "{{appStrings.promissory.loadFromJsonApi}}",
            "style": {
              "type": "custom",
              "color": "{{appColors.current.text.hint}}",
              "fontSize": 16.0,
              "fontWeight": "w600"
            },
            "textDirection": "rtl",
            "type": "text"
          },
          "type": "outlinedButton"
        }
      ],
      "type": "column"
    },
    "type": "padding"
  },
  "type": "scaffold"
}