{
  "type": "stateFull",
  "child": {
    "appBar": {
      "leading": {
        "padding": {
          "left": 12
        },
        "child": {
          "child": {
            "src": "{{appAssets.icons.support}}",
            "imageType": "asset",
            "color": "{{appColors.current.text.title}}",
            "width": 24,
            "height": 24,
            "type": "image"
          },
          "type": "center"
        },
        "type": "padding"
      },
      "automaticallyImplyLeading": true,
      "title": {
        "data": "بستن سپرده",
        "style": {
          "type": "alias",
          "value": "{{appStyles.appbarStyle}}"
        },
        "textDirection": "rtl",
        "type": "text"
      },
      "actions": [
        {
          "padding": {
            "right": 12
          },
          "child": {
            "onPressed": {
              "navigationStyle": "pop",
              "actionType": "navigate"
            },
            "icon": {
              "src": "{{appAssets.icons.arrowBack}}",
              "imageType": "asset",
              "color": "{{appColors.current.text.title}}",
              "width": 31,
              "height": 31,
              "type": "image"
            },
            "type": "iconButton"
          },
          "type": "padding"
        }
      ],
      "centerTitle": true,
      "type": "appBar"
    },
    "body": {
      "padding": {
        "left": 16,
        "top": 16,
        "right": 16,
        "bottom": 16
      },
      "child": {
        "crossAxisAlignment": "stretch",
        "children": [
          {
            "decoration": {
              "border": {
                "color": "{{appColors.current.input.borderEnabled}}",
                "width": 1
              },
              "borderRadius": {
                "topLeft": 8,
                "topRight": 8,
                "bottomLeft": 8,
                "bottomRight": 8
              }
            },
            "child": {
              "padding": {
                "left": 16,
                "top": 16,
                "right": 16,
                "bottom": 16
              },
              "child": {
                "children": [
                  {
                    "src": "assets/icons/ic_success_new.svg",
                    "imageType": "asset",
                    "width": 40,
                    "height": 40,
                    "type": "image"
                  },
                  {
                    "height": 16,
                    "type": "sizedBox"
                  },
                  {
                    "data": "درخواست شما با موفقیت ثبت شد!",
                    "style": {
                      "type": "custom",
                      "color": "{{appColors.current.text.title}}",
                      "fontSize": 14,
                      "fontWeight": "w600"
                    },
                    "textAlign": "center",
                    "textDirection": "rtl",
                    "type": "text"
                  },
                  {
                    "height": 16,
                    "type": "sizedBox"
                  },
                  {
                    "data": "این درخواست توسط همکاران ما بررسی می‌گردد و مراتب از طریق پیامک به شما اطلاع‌رسانی خواهد شد",
                    "style": {
                      "type": "custom",
                      "color": "{{appColors.current.text.subtitle}}",
                      "fontSize": 14,
                      "fontWeight": "w500",
                      "height": 1.6
                    },
                    "textAlign": "center",
                    "textDirection": "rtl",
                    "type": "text"
                  }
                ],
                "type": "column"
              },
              "type": "padding"
            },
            "type": "container"
          },
          {
            "child": {
              "type": "sizedBox"
            },
            "type": "expanded"
          },
          {
            "onPressed": {
              "navigationStyle": "pop",
              "actionType": "navigate"
            },
            "style": {
              "foregroundColor": "{{appColors.current.button.primary.foregroundColor}}",
              "backgroundColor": "{{appColors.current.button.primary.backgroundColor}}",
              "minimumSize": {
                "width": 0,
                "height": 64
              },
              "shape": {
                "type": "roundedRectangleBorder",
                "borderRadius": {
                  "topLeft": 12,
                  "topRight": 12,
                  "bottomLeft": 12,
                  "bottomRight": 12
                }
              }
            },
            "child": {
              "data": "بازگشت",
              "style": {
                "type": "custom",
                "fontSize": 18,
                "fontWeight": "w700"
              },
              "textDirection": "rtl",
              "type": "text"
            },
            "type": "filledButton"
          }
        ],
        "type": "column"
      },
      "type": "padding"
    },
    "type": "scaffold"
  }
}
