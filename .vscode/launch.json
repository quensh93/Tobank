{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (No Pub - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--flavor",
        "dev",
        "--no-pub",
        "-d",
        "chrome"
      ],
      "args": [
        "--web-browser-flag",
        "--disable-web-security"
      ]
    },
    {
      "name": "Flutter (Profile Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "Flutter (Release Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": [
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "Flutter (Simulate End-User)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--flavor",
        "prod",
        "--dart-define=API=true",
        "--dart-define=START_APP_FROM_API=true"
      ]
    }
  ]
}
