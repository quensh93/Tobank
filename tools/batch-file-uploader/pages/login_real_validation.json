                      "keyboardType": "text",
                      "textInputAction": "next",
                      "onChanged": {
                        "actionType": "validateFields",
                        "resultKey": "isLoginFormValid",
                        "fields": [
                          {
                            "id": "mobile_number",
                            "rule": "^09\\d{9}$"
                          },
                          {
                            "id": "national_code",
                            "rule": "^\\d{10}$"
                          },
                          {
                            "id": "birthdate",
                            "rule": ".+"
                          }
                        ]
                      }
                    },
                    "visible": false,
                    "type": "visibility"
                  },
                  {
                    "data": "{{appStrings.promissory.birthdate}}",
                    "style": {
                      "type": "alias",
                      "value": "{{appStyles.text.label}}"
                    },
                    "textDirection": "rtl",
                    "type": "text"
                  },
                  {
                    "height": 8.0,
                    "type": "sizedBox"
                  },
                  {
                    "child": {
                      "id": "birthdate",
                      "decoration": {
                        "hintText": "{{appStrings.promissory.selectBirth}}",
                        "prefixIcon": {
                          "padding": {
                            "left": 8.0,
                            "top": 8.0,
                            "right": 8.0,
                            "bottom": 8.0
                          },
                          "child": {
                            "src": "assets/icons/ic_calendar.svg",
                            "imageType": "asset",
                            "color": "{{appColors.current.secondary.color}}",
                            "width": 24.0,
                            "height": 24.0,
                            "fit": "scaleDown",
                            "type": "image"
                          },
                          "type": "padding"
                        },
                        "contentPadding": {
                          "left": 16.0,
                          "top": 12.0,
                          "right": 16.0,
                          "bottom": 12.0
                        },
                        "filled": false
                      },
                      "keyboardType": "text",
                      "textAlign": "right",
                      "textDirection": "rtl",
                      "readOnly": true,
                      "enabled": false,
                      "validatorRules": [
                        {
                          "rule": ".+",
                          "message": "{{appStrings.promissory.birthdateRequired}}"
                        }
                      ],
                      "type": "textFormField"
                    },
                    "onTap": {
                      "actionType": "persianDatePicker",
                      "formFieldId": "birthdate",
                      "firstDate": "1300/01/01",
                      "lastDate": "1450/12/29",
                      "onDateSelected": {
                        "actionType": "validateFields",
                        "resultKey": "isLoginFormValid",
                        "fields": [
                          {
                            "id": "mobile_number",
                            "rule": "^09\\d{9}$"
                          },
                          {
                            "id": "national_code",
                            "rule": "^\\d{10}$"
                          },
                          {
                            "id": "birthdate",
                            "rule": ".+"
                          }
                        ]
                      }
                    },
                    "type": "gestureDetector"
                  }
                ],
                "type": "column"
              },
              "type": "singleChildScrollView"
            },
            "type": "expanded"
          },
          {
            "padding": {
              "left": 16.0,
              "top": 16.0,
              "right": 16.0,
              "bottom": 16.0
            },
            "child": {
              "type": "reactiveElevatedButton",
              "enabledKey": "isLoginFormValid",
              "onPressed": {
                "actionType": "sequence",
                "actions": [
                  {
                    "actionType": "setValue",
                    "values": [
                      {
                        "key": "login.mobile",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "mobile_number"
                        }
                      },
                      {
                        "key": "login.nationalCode",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "national_code"
                        }
                      },
                      {
                        "key": "login.gpayToken",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "gpay_token"
                        }
                      },
                      {
                        "key": "login.cif",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "cif"
                        }
                      },
                      {
                        "key": "login.birthDate",
                        "value": {
                          "actionType": "getFormValue",
                          "id": "birthdate"
                        }
                      },
                      {
                        "key": "login.birthDateClean",
                        "value": "{{replace(login.birthDate,'/','')}}"
                      }
                    ]
                  },
                  {
                    "actionType": "networkRequest",
                    "url": "http://192.168.107.22:8280/api/digitalbanking/logins/v1.0/tobank/users",
                    "method": "post",
                    "data": {
                      "nationalId": "{{login.nationalCode}}",
                      "mobileNumber": "{{login.mobile}}",
                      "gpayToken": "{{login.gpayToken}}",
                      "birthDate": "{{login.birthDateClean}}",
                      "cif": "{{login.cif}}"
                    },
                    "headers": {
                      "accept": "*/*",
                      "app-platform": "android",
                      "app-store": "application/json",
                      "app-version": "456",
                      "authorization": "Bearer null",
                      "content-type": "application/json",
                      "device-uuid": "5109ab4c-77ca-4f0c-9858-da4df58031d2",
                      "serviceauthorization": "Basic Z2ZRdDVha3U2anVCQW9DWHhPcEJya3J2S1dRYTpxUmZkUXp5WmhYSFRKcmZ0UGd6Zk9CRFpCUllhbDBaT0RUZ291MEVST2d3YQ=="
                    },
                    "results": [
                      {
                        "statusCode": 200,
                        "action": {
                          "actionType": "sequence",
                          "actions": [
                            {
                              "actionType": "setValue",
                              "values": [
                                {
                                  "key": "auth.accessToken",
                                  "value": "{{data.result.data.access_token}}"
                                },
                                {
                                  "key": "auth.accessTokenRaw",
                                  "value": "{{replace(data.result.data.access_token,'Bearer ','')}}"
                                },
                                {
                                  "key": "userData.nationalCode",
                                  "value": "{{login.nationalCode}}"
                                }
                              ]
                            },
                            {
                              "actionType": "auth_persist",
                              "accessToken": "{{data.result.data.access_token}}",
                              "nationalCode": "{{login.nationalCode}}"
                            },
                            {
                              "actionType": "showSnackBar",
                              "content": {
                                "type": "text",
                                "data": "{{appStrings.promissory.loginSuccess}}"
                              }
                            },
                            {
                              "actionType": "navigate",
                              "navigationStyle": "push",
                              "request": {
                                "url": "http://192.168.179.21:8101/api/configurations/v1.0/configs/resolve/ipaam.builder.form.form.promissory_real_intro/1",
                                "method": "post",
                                "headers": {
                                  "Content-Type": "application/json",
                                  "Accept": "*/*"
                                },
                                "body": {
                                  "operator": "is",
                                  "dimension": {
                                    "app": "mobile"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              "style": {
                "backgroundColor": "{{appColors.current.primary.color}}",
                "elevation": 0.0,
                "fixedSize": {
                  "width": 999999.0,
                  "height": 56.0
                },
                "shape": {
                  "type": "roundedRectangleBorder",
                  "borderRadius": {
                    "topLeft": 8.0,
                    "topRight": 8.0,
                    "bottomLeft": 8.0,
                    "bottomRight": 8.0
                  }
                }
              },
              "child": {
                "data": "{{appStrings.promissory.loginSaveToken}}",
                "style": {
                  "type": "custom",
                  "color": "{{appColors.current.primary.onPrimary}}",
                  "fontSize": 16.0,
                  "fontWeight": "bold"
                },
                "textDirection": "rtl",
                "type": "text"
