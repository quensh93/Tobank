                    "onChanged": {
                      "actionType": "validateFields",
                      "resultKey": "isLoginFormValid",
                      "fields": [
                        {
                          "id": "mobile_number",
                          "rule": "^09\\d{9}$"
                        },
                        {
                          "id": "national_code",
                          "rule": "^\\d{10}$"
                        },
                        {
                          "id": "birthdate",
                          "rule": ".+"
                        }
                      ]
                    }
                  },
                  {
                    "height": 16.0,
                    "type": "sizedBox"
                  },
                  {
                    "child": {
                      "type": "textFormField",
                      "id": "gpay_token",
                      "initialValue": "1234",
                      "textDirection": "ltr",
                      "textAlign": "left",
                      "decoration": {
                        "hintText": "{{appStrings.promissory.gpayTokenExample}}",
