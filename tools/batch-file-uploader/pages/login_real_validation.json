                          {
                            "id": "national_code",
                            "rule": "^\\d{10}$"
                          },
                          {
                            "id": "birthdate",
                            "rule": ".+"
                          }
                        ]
                      }
                    },
                    "visible": false,
                    "type": "visibility"
                  },
                  {
                    "height": 16.0,
                    "type": "sizedBox"
                  },
                  {
                    "child": {
                      "type": "textFormField",
                      "id": "cif",
                      "initialValue": "123",
                      "textDirection": "ltr",
                      "textAlign": "left",
                      "decoration": {
                        "hintText": "{{appStrings.promissory.cifExample}}",
                        "contentPadding": {
                          "left": 16.0,
                          "top": 12.0,
                          "right": 16.0,
                          "bottom": 12.0
