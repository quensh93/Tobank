                    },
                    "textDirection": "rtl",
                    "type": "text"
                  },
                  {
                    "height": 8.0,
                    "type": "sizedBox"
                  },
                  {
                    "type": "textFormField",
                    "id": "national_code",
                    "textDirection": "rtl",
                    "textAlign": "right",
                    "maxLength": 10,
                    "inputFormatters": [
                      {
                        "type": "allow",
                        "rule": "[0-9]"
                      }
                    ],
                    "decoration": {
                      "hintText": "{{appStrings.promissory.enterNationalCodee}}",
                      "contentPadding": {
                        "left": 16.0,
                        "top": 12.0,
