{
  "permissions": {
    "allow": [
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(npm install:*)",
      "Bash(claude --version:*)",
      "Bash(claude auth:*)",
      "WebFetch(domain:github.com)",
      "Bash(gh api *)",
      "PowerShell(uv --version)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\alisi\\.local\\bin\\graphify.EXE hook-check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c if exist graphify-out\\GRAPH_REPORT.md (echo [graphify] Graph is available. Read graphify-out/GRAPH_REPORT.md before exploring the codebase.) else (echo [graphify] No graph found. Run: graphify update .)"
          }
        ]
      }
    ]
  }
}
